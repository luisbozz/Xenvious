    <Geometry x:Key="EditIconSurvival">M12,3 L19,6 V11 C19,16 16,19 12,21 C8,19 5,16 5,11 V6 Z</Geometry>
    <Geometry x:Key="EditIconEntity">M4,5 H20 V19 H4 Z M4,10 H20 M9,10 V19</Geometry>
    <Geometry x:Key="EditIconBits">M4,6 H8 V10 H4 Z M10,6 H14 V10 H10 Z M16,6 H20 V10 H16 Z M4,14 H8 V18 H4 Z M16,14 H20 V18 H16 Z</Geometry>
