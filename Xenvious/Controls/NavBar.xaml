<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Top navigation: pages sit in grey groups, each button shows an outline icon left
         of its label. MainPages_SelectionChanged sets Tag to "active" on the button of
         the open page; everything else here is plain styling. -->

    <SolidColorBrush x:Key="NavGroupBackgroundBrush" Color="#FF232529"/>
    <SolidColorBrush x:Key="NavMutedBrush" Color="#FFA3A6AA"/>

    <Style x:Key="NavGroup" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource NavGroupBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- The icons are drawn on a 24x24 canvas; the Viewbox scales canvas and stroke
         together, so every icon keeps the same proportions. -->
    <Style x:Key="NavIconBox" TargetType="{x:Type Viewbox}">
        <Setter Property="Width" Value="17"/>
        <Setter Property="Height" Value="17"/>
        <Setter Property="Margin" Value="0,0,7,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="NavIcon" TargetType="{x:Type Path}">
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
    </Style>

    <!-- MainWindow's implicit TextBlock style fixes colour and size; the label takes both
         from the button instead, so hover and the active page change its colour. -->
    <Style x:Key="NavLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
        <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
    </Style>

    <Style x:Key="NavButton" TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FontFamily" Value="{DynamicResource Volte}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource NavMutedBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="11,7"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="active">
                            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SeactionHeaderBackgroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical page lists (Misc, later Edit): a muted group heading and full-width
         entries with the same hover and "active" look as the top navigation. -->
    <Style x:Key="SideNavGroup" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#FF72767D"/>
        <Setter Property="Margin" Value="10,14,0,4"/>
    </Style>

    <Style x:Key="SideNavButton" TargetType="{x:Type Button}" BasedOn="{StaticResource NavButton}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border" CornerRadius="5" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                            <Setter TargetName="border" Property="Background" Value="#FF34373C"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="active">
                            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SeactionHeaderBackgroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A plain filled button for forms (grey, lighter on hover); "Danger" in red. -->
    <Style x:Key="FormButton" TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FontFamily" Value="{DynamicResource Volte}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="Background" Value="{DynamicResource SeactionHeaderBackgroundBrush}"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="b" CornerRadius="5" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FormButtonDanger" TargetType="{x:Type Button}" BasedOn="{StaticResource FormButton}">
        <Setter Property="Background" Value="#FF8E2F2C"/>
    </Style>

    <!-- 24x24 outline icons, drawn with the button's foreground. -->
    <Geometry x:Key="NavIconDashboard">M4,4 H11 V11 H4 Z M13,4 H20 V8 H13 Z M13,10 H20 V20 H13 Z M4,13 H11 V20 H4 Z</Geometry>
    <Geometry x:Key="NavIconEdit">M4,20 H8 L19,9 L15,5 L4,16 Z M13,7 L17,11</Geometry>
    <Geometry x:Key="NavIconCopy">M10,8 H18 A2,2 0 0 1 20,10 V18 A2,2 0 0 1 18,20 H10 A2,2 0 0 1 8,18 V10 A2,2 0 0 1 10,8 Z M16,8 V5 A1,1 0 0 0 15,4 H5 A1,1 0 0 0 4,5 V15 A1,1 0 0 0 5,16 H8</Geometry>
    <Geometry x:Key="NavIconConvert">M4,8 H17 L14,5 M20,16 H7 L10,19</Geometry>
    <Geometry x:Key="NavIconTeleport">M12,21 C12,21 5,14.5 5,10 A7,7 0 0 1 19,10 C19,14.5 12,21 12,21 Z M12,7 A3,3 0 1 1 11.99,7 Z</Geometry>
    <Geometry x:Key="NavIconEditor">M8,5 L3,12 L8,19 M16,5 L21,12 L16,19</Geometry>
    <Geometry x:Key="NavIconMisc">M5,10.5 A1.5,1.5 0 1 1 4.99,10.5 Z M12,10.5 A1.5,1.5 0 1 1 11.99,10.5 Z M19,10.5 A1.5,1.5 0 1 1 18.99,10.5 Z</Geometry>
    <Geometry x:Key="NavIconSettings">M12,9 A3,3 0 1 1 11.99,9 Z M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9</Geometry>

    <!-- Edit side list, same 24x24 grid. -->
    <Geometry x:Key="EditIconProps">M12,3 L20,7.5 V16.5 L12,21 L4,16.5 V7.5 Z M12,12 L20,7.5 M12,12 V21 M12,12 L4,7.5</Geometry>
    <Geometry x:Key="EditIconVehicle">M5,16 H19 M6,16 L7.5,11 H16.5 L18,16 M6.5,17.5 A1.5,1.5 0 1 1 9.5,17.5 A1.5,1.5 0 1 1 6.5,17.5 M14.5,17.5 A1.5,1.5 0 1 1 17.5,17.5 A1.5,1.5 0 1 1 14.5,17.5</Geometry>
    <Geometry x:Key="EditIconWeapon">M3,10 H16 L18,12 H21 V15 H15 L14,18 H11 L12,15 H3 Z</Geometry>
    <Geometry x:Key="EditIconActor">M8.5,7 A3.5,3.5 0 1 1 15.5,7 A3.5,3.5 0 1 1 8.5,7 M5,20 C6,16 9,14 12,14 C15,14 18,16 19,20</Geometry>
    <Geometry x:Key="EditIconDoor">M6,21 V4 H18 V21 M4,21 H20 M14,12.5 H15</Geometry>
    <Geometry x:Key="EditIconZone">M4,6 A2,2 0 0 1 6,4 H18 A2,2 0 0 1 20,6 V18 A2,2 0 0 1 18,20 H6 A2,2 0 0 1 4,18 Z M9,12 H15 M12,9 V15</Geometry>
    <Geometry x:Key="EditIconMission">M6,21 V4 M6,4 H17 L15,8 L17,12 H6</Geometry>
