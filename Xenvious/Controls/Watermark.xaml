<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Xenvious">

    <Style x:Key="Watermark" TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="{DynamicResource Volte}"/>
        <Setter Property="FontSize" Value="14.0"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="Cursor" Value="IBeam"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxBorderInner}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBoxForegroundThemeBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ComboBoxBackground}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ScrollViewer.PanningMode" Value="None"/>
        <Setter Property="local:CornerRadiusSetter.CornerRadius" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}" x:Name="main">
                    <ControlTemplate.Resources>
                        <local:IsStringNotEmpty x:Key="isStringNotEmpty"/>
                    </ControlTemplate.Resources>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Border" Grid.ColumnSpan="3" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="{TemplateBinding local:CornerRadiusSetter.CornerRadius}"/>

                        <Grid x:Name="WaterMarkGrid" Margin="2,0,0,0" Visibility="Visible" Cursor="{TemplateBinding Cursor}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" MaxWidth="170"/>
                                <ColumnDefinition Width="3"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Cursor="{TemplateBinding Cursor}" Text="{TemplateBinding Tag}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        Foreground="Gray" FontFamily="{DynamicResource Volte}" Margin="4 0" FontSize="{TemplateBinding FontSize}" TextTrimming="CharacterEllipsis" TextWrapping="{TemplateBinding TextWrapping}"/>

                            <Rectangle Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Stretch" Fill="{DynamicResource ComboBoxBorderInner}" Height="{Binding Path=Height, ElementName=WaterMarkGrid}" Margin="0 3" Width="1" />


                        </Grid>
                        <ScrollViewer Margin="6,0,0,0" x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" PanningMode="None" Cursor="{TemplateBinding Cursor}"/>

                    </Grid>

                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource isStringNotEmpty}}" Value="true">
                            <Setter TargetName="WaterMarkGrid" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="DimGray"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ComboBoxBorder}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="true">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ComboBoxBorder}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ComboBoxBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <BorderGapMaskConverter x:Key="BorderGapMaskConverter"/>
</ResourceDictionary>