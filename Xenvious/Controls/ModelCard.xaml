<UserControl x:Class="Xenvious.ModelCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The model of the selected entry: picture, name, hash, the catalog button, and the
         recently used and favourite models as one-click chips. -->
    <UserControl.Resources>
        <Style x:Key="Chip" TargetType="{x:Type Button}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="b" Background="{DynamicResource DeepBrush}" CornerRadius="11" Padding="9,3">
                            <TextBlock x:Name="t" Text="{TemplateBinding Content}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource TextColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
    <!-- Accent frame of a hero card, drawn over the card so the header corners stay under it (as SectionCard). -->
    <Border x:Name="Ring" Margin="-3" CornerRadius="9" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}" Opacity="0.22" Visibility="Collapsed" IsHitTestVisible="False"/>
    <Border x:Name="Root" Background="{DynamicResource SectionBackgroundBrush}" CornerRadius="6">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SeactionHeaderBackgroundBrush}" CornerRadius="6,6,0,0" Padding="12,8">
                <DockPanel>
                    <!-- Lighter than the header bar, with a pencil and a verb, so it reads as the way to change the model. -->
                    <Button x:Name="CatalogButton" DockPanel.Dock="Right" Style="{StaticResource FormButtonPrimary}" Height="28" Padding="10,0" Click="CatalogButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M9,2 L12,5 L5,12 L2,12 L2,9 Z" Stroke="{DynamicResource PrimaryButtonForeground}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                  Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <!-- Explicit colour: the default TextBlock style would paint it in the text colour, white on the light button. -->
                            <TextBlock VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryButtonForeground}" Text="{Binding Translation[catalog_change], FallbackValue='Change model'}"/>
                        </StackPanel>
                    </Button>
                    <!-- Icon tile like the entity page cards (SectionCard); only when a page sets HeaderIcon. -->
                    <Grid x:Name="IconTile" DockPanel.Dock="Left" Width="26" Height="26" Margin="0,0,10,0" Visibility="Collapsed">
                        <Border CornerRadius="6" Background="{DynamicResource AccentBrush}" Opacity="0.16"/>
                        <Path x:Name="IconPath" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="14" Height="14"/>
                    </Grid>
                    <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"
                               Text="{Binding Translation[model], FallbackValue=Model}"/>
                </DockPanel>
            </Border>

            <!-- Shown instead of the model while the creator has no entry of this kind or none is selected. -->
            <StackPanel x:Name="EmptyPanel" DockPanel.Dock="Top" Margin="16,22" Visibility="Collapsed">
                <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource DeepBrush}" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Path Data="M12,2 L22,7 L22,17 L12,22 L2,17 L2,7 Z M2,7 L12,12 L22,7 M12,12 L12,22" Stroke="{DynamicResource FaintTextBrush}" StrokeThickness="1.6"
                          StrokeLineJoin="Round" Stretch="Uniform" Width="18" Height="18"/>
                </Border>
                <StackPanel x:Name="NothingPlaced">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" TextAlignment="Center" TextWrapping="Wrap"
                               Text="{Binding Translation[card_noplaced], FallbackValue='Nothing placed yet'}"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="{Binding Translation[card_noplaced_hint], FallbackValue='Place one in the creator first, then change its model here.'}"/>
                </StackPanel>
                <StackPanel x:Name="NothingSelected">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" TextAlignment="Center" TextWrapping="Wrap"
                               Text="{Binding Translation[card_noselect], FallbackValue='No entry selected'}"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="{Binding Translation[card_noselect_hint], FallbackValue='Select a number above to see and change its model.'}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="ContentPanel" Margin="12,10">
                <DockPanel>
                    <!-- The picture opens the catalog too; hovering it says so. -->
                    <Button Width="150" Height="112" Margin="0,0,12,0" VerticalAlignment="Top" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="CatalogButton_Click"
                            ToolTip="{Binding Translation[catalog_change], FallbackValue='Change model'}">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Grid>
                                    <Border CornerRadius="4" Background="{DynamicResource DeepBrush}" ClipToBounds="True">
                                        <Grid>
                                            <!-- Shown until the picture has loaded, or when the model has none. -->
                                            <Rectangle RadiusX="4" RadiusY="4" Margin="6" Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5" StrokeDashArray="4 3"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="M5,17 L19,17 M3,13 L5,7 L19,7 L21,13 L21,17 L3,17 Z M5.7,17 A1.8,1.8 0 1 1 9.3,17 A1.8,1.8 0 1 1 5.7,17 M14.7,17 A1.8,1.8 0 1 1 18.3,17 A1.8,1.8 0 1 1 14.7,17"
                                                      Stroke="{DynamicResource FaintTextBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="Uniform" Width="26" Height="20" HorizontalAlignment="Center"/>
                                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FaintTextBrush}" Margin="0,6,0,0" HorizontalAlignment="Center"
                                                           Text="{Binding Translation[catalog_nopreview], FallbackValue=Preview}"/>
                                            </StackPanel>
                                            <ContentPresenter/>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="overlay" CornerRadius="4" Background="#8C000000" Opacity="0">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="White"
                                                   Text="{Binding Translation[catalog_change_short], FallbackValue=Change}"/>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="overlay" Property="Opacity" Value="1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Image x:Name="Thumb" Stretch="UniformToFill"/>
                    </Button>
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock x:Name="NameText" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextColor}" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis"/>
                        <!-- A read-only box, so native name and hash can be selected and copied. -->
                        <TextBox x:Name="DetailText" Style="{x:Null}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource MutedTextBrush}" Margin="-2,2,0,0" Cursor="IBeam"/>
                        <TextBlock x:Name="CategoryText" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource FaintTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <!-- What the entity does in the mission (own rule, extra objectives, when it exists); filled by the page. -->
                        <WrapPanel x:Name="InfoChips" Margin="0,10,0,0"/>
                    </StackPanel>
                </DockPanel>

                <TextBlock x:Name="RecentLabel" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FaintTextBrush}" Margin="0,14,0,6"
                           Text="{Binding Translation[catalog_recent], FallbackValue='Recently used'}"/>
                <WrapPanel x:Name="RecentChips"/>

                <TextBlock x:Name="FavoriteLabel" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FaintTextBrush}" Margin="0,10,0,6"
                           Text="{Binding Translation[catalog_favorites], FallbackValue=Favourites}"/>
                <WrapPanel x:Name="FavoriteChips"/>
            </StackPanel>
        </DockPanel>
    </Border>
    <Border x:Name="Frame" CornerRadius="6" BorderThickness="1.5" BorderBrush="Transparent" IsHitTestVisible="False" UseLayoutRounding="True"/>
    </Grid>
</UserControl>
