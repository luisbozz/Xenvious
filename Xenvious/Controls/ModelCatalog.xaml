<UserControl x:Class="Xenvious.ModelCatalog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Xenvious"
             Visibility="Collapsed" Focusable="True" KeyDown="Catalog_KeyDown">
    <!-- Model catalog over the whole window: categories, a search, the list with pictures and a
         preview. Filled and shown through Show(); the page that opened it writes the model. -->
    <Grid Background="#99000000" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown">
        <Border Background="{DynamicResource SectionBackgroundBrush}" CornerRadius="8" MaxWidth="1100" MaxHeight="720" Margin="40"
                MouseLeftButtonDown="Panel_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="Black"/>
            </Border.Effect>
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource SeactionHeaderBackgroundBrush}" CornerRadius="8,8,0,0" Padding="16,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource NavButton}" Padding="8,4" Click="Close_Click" Content="✕"/>
                        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" BorderBrush="#FF3A3D43" BorderThickness="0,1,0,0" Padding="16,10">
                    <DockPanel>
                        <Button x:Name="TakeButton" DockPanel.Dock="Right" Style="{StaticResource NavButton}" Background="#FF2D6A4F" Foreground="#FFFFFFFF" Padding="16,8" Click="Take_Click">
                            <TextBlock Style="{StaticResource NavLabel}" Text="{Binding Translation[catalog_take], FallbackValue=Use}"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource NavButton}" Padding="16,8" Margin="0,0,8,0" Click="Close_Click">
                            <TextBlock Style="{StaticResource NavLabel}" Text="{Binding Translation[catalog_cancel], FallbackValue=Cancel}"/>
                        </Button>
                        <TextBlock x:Name="CacheHint" VerticalAlignment="Center" FontSize="12" Foreground="#FF72767D" TextWrapping="Wrap"
                                   Text="{Binding Translation[catalog_cachehint], FallbackValue='Pictures load on first view and are kept on disk; see Settings › Picture cache.'}"/>
                    </DockPanel>
                </Border>

                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>

                    <!-- Categories with their counts. -->
                    <ListBox x:Name="CategoryList" Grid.Column="0" Background="Transparent" BorderThickness="0" Margin="0,0,12,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="CategoryList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" CornerRadius="4" Padding="9,6" Background="Transparent">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="12" Foreground="#FF72767D"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#FFA3A6AA" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#FF34373C"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource TextBoxBackground}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <DockPanel Grid.Column="1">
                        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource Watermark}" Height="34" FontSize="14" Margin="0,0,0,6"
                                 Tag="{Binding Translation[catalog_search], FallbackValue='Name, native or hash'}" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="HitCount" DockPanel.Dock="Top" FontSize="12" Foreground="#FF72767D" Margin="4,0,0,4"/>
                        <!-- Virtualized: only the rows on screen exist, and only they load pictures. -->
                        <ListBox x:Name="ItemList" Background="Transparent" BorderThickness="0"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                                 SelectionChanged="ItemList_SelectionChanged" MouseDoubleClick="ItemList_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="b" CornerRadius="4" Padding="6,4" Background="Transparent">
                                                    <DockPanel>
                                                        <Border Width="52" Height="40" CornerRadius="3" Background="#FF232529" Margin="0,0,10,0" ClipToBounds="True">
                                                            <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <!-- Star: add to or remove from the favourites. -->
                                                        <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsFavorite, Mode=TwoWay}" Width="26" Height="26" Cursor="Hand" Focusable="False"
                                                                      ToolTip="{Binding DataContext.Translation[catalog_favorite], RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=Favourite}">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <TextBlock x:Name="star" Text="★" FontSize="16" Foreground="#FF4F545C" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"/>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="star" Property="Foreground" Value="#FFFAC828"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="star" Property="Opacity" Value="0.8"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" FontSize="11" Foreground="#FF72767D" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextColor}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Detail}" FontSize="11" FontFamily="Consolas" Foreground="#FFA3A6AA" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#FF34373C"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource SeactionHeaderBackgroundBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>

                    <!-- Preview of the selected model. -->
                    <Border Grid.Column="2" Margin="12,0,0,0" Background="#FF232529" CornerRadius="6" Padding="12" VerticalAlignment="Top">
                        <StackPanel>
                            <Border Height="170" CornerRadius="4" Background="#FF1B1D20" ClipToBounds="True">
                                <Image x:Name="PreviewImage" Stretch="Uniform"/>
                            </Border>
                            <TextBlock x:Name="PreviewName" Margin="0,10,0,0" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextColor}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PreviewNative" FontSize="12" FontFamily="Consolas" Foreground="#FFA3A6AA" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PreviewHash" FontSize="12" FontFamily="Consolas" Foreground="#FFA3A6AA" Margin="0,2,0,0"/>
                            <TextBlock x:Name="PreviewCategory" FontSize="12" FontWeight="Bold" Foreground="#FF72767D" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
