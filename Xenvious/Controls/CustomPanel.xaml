<UserControl x:Class="Controls.CustomPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" Width="800"
             x:Name="CPanel">

    <Border Background="#2F3136" CornerRadius="5" Padding="0,0,0,5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Margin="3" CornerRadius="5" Background="#36393F" Grid.Row="0">
                <Viewbox VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Label Name="HeaderLabel" Foreground="{DynamicResource TextColor}" FontFamily="{DynamicResource Volte}" FontWeight="Bold" Content="{Binding Path=HeaderText, ElementName=CPanel}"/>
                </Viewbox>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="7">
                
            </ScrollViewer>
            
        </Grid>
    </Border>
</UserControl>
