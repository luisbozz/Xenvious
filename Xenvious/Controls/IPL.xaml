<UserControl x:Class="Xenvious.IPL"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             xmlns:local="clr-namespace:Xenvious"
             Height="185.333" Width="175" >

    <Border BorderThickness="1" CornerRadius="5" BorderBrush="{DynamicResource SectionBackgroundBrush}" Background="{DynamicResource SectionBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="5" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="0.13*" MinHeight="50" MaxHeight="100"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--Top-->

            <Border Grid.Row="0" CornerRadius="5" Background="{DynamicResource SeactionHeaderBackgroundBrush}" Margin="8,5,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox VerticalAlignment="Stretch" HorizontalAlignment="Left">
                        <Label Foreground="{DynamicResource TextColor}" FontFamily="{DynamicResource Volte}" FontWeight="Bold" Content="{Binding HeaderText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=Header}" />
                    </Viewbox>
                    <Border CornerRadius="5" Background="{DynamicResource SectionBackgroundBrush}" Margin="0,0,5,0" Grid.Column="1" Height="22" Width="22" VerticalAlignment="Center" HorizontalAlignment="Right" >
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="2"/>
                        </Border.Effect>
                        <CheckBox x:Name="cbenable" Checked="cbenable_Checked" Unchecked="cbenable_Checked" Height="22" Width="22"/>
                    </Border>
                </Grid>
            </Border>

            <!--Bottom-->
            <Grid Grid.Row="1" Margin="8,10,8,10" MouseLeftButtonDown="Grid_MouseLeftButtonDown" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="0.5*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Translation[vector3x], FallbackValue=X-Component}" Foreground="{DynamicResource TextColor}" FontSize="10" FontFamily="{DynamicResource Volte}" Grid.Row="0" VerticalAlignment="Center" Margin="10,0,0,0" />
                <TextBlock Text="{Binding Translation[vector3y], FallbackValue=Y-Component}" Foreground="{DynamicResource TextColor}" FontSize="10" FontFamily="{DynamicResource Volte}" Grid.Row="1" VerticalAlignment="Center" Margin="10,0,0,0" />
                <TextBlock Text="{Binding Translation[vector3z], FallbackValue=Z-Component}" Foreground="{DynamicResource TextColor}" FontSize="10" FontFamily="{DynamicResource Volte}" Grid.Row="2" VerticalAlignment="Center" Margin="10,0,0,0" />
                
                <TextBlock x:Name="locx" Foreground="{DynamicResource TextColor}" FontSize="10" FontFamily="{DynamicResource Volte}" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                <TextBlock x:Name="locy" Foreground="{DynamicResource TextColor}" FontSize="10" FontFamily="{DynamicResource Volte}" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                <TextBlock x:Name="locz" Foreground="{DynamicResource TextColor}" FontSize="10" FontFamily="{DynamicResource Volte}" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />

                <Border Grid.ColumnSpan="2" Grid.Row="6" CornerRadius="5" Background="{DynamicResource SectionBackgroundBrush}" Margin="5 0" Height="26" VerticalAlignment="Bottom">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="2"/>
                    </Border.Effect>
                    <Button x:Name="Btnteleport" Style="{DynamicResource CustomButton}" Content="{Binding Translation[teleport], FallbackValue=Teleport}" local:CornerRadiusSetter.CornerRadius="5" Click="Btnteleport_Click"/>
                </Border>

            </Grid>

        </Grid>
    </Border>

</UserControl>
