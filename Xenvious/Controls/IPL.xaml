<UserControl x:Class="Xenvious.IPL"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             xmlns:local="clr-namespace:Xenvious"
             Width="200" Margin="0,0,12,12">

    <!-- One interior as a card: name and on/off switch in the header, position and teleport below. -->
    <Border CornerRadius="6" Background="{DynamicResource SectionBackgroundBrush}">
        <DockPanel>
            <Border DockPanel.Dock="Top" CornerRadius="6,6,0,0" Background="{DynamicResource SeactionHeaderBackgroundBrush}" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{DynamicResource TextColor}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding HeaderText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, FallbackValue=Header}"/>
                    <CheckBox x:Name="cbenable" Grid.Column="1" VerticalAlignment="Center" Checked="cbenable_Checked" Unchecked="cbenable_Checked"/>
                </Grid>
            </Border>

            <Grid Margin="12,10,12,12" MouseLeftButtonDown="Grid_MouseLeftButtonDown" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="X" Foreground="#FF72767D" FontSize="11" FontWeight="Bold" Grid.Row="0" VerticalAlignment="Center"/>
                <TextBlock Text="Y" Foreground="#FF72767D" FontSize="11" FontWeight="Bold" Grid.Row="1" VerticalAlignment="Center"/>
                <TextBlock Text="Z" Foreground="#FF72767D" FontSize="11" FontWeight="Bold" Grid.Row="2" VerticalAlignment="Center"/>

                <TextBlock x:Name="locx" Foreground="{DynamicResource TextColor}" FontSize="13" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock x:Name="locy" Foreground="{DynamicResource TextColor}" FontSize="13" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock x:Name="locz" Foreground="{DynamicResource TextColor}" FontSize="13" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <Button x:Name="Btnteleport" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource FormButton}" Height="30" Margin="0,10,0,0" Content="{Binding Translation[teleport], FallbackValue=Teleport}" Click="Btnteleport_Click"/>
            </Grid>
        </DockPanel>
    </Border>

</UserControl>
