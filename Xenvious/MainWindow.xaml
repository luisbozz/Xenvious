                                                <CheckBox x:Name="cbsettingsswitchcamkey" Grid.Column="1" Style="{StaticResource FormToggle}" Checked="cbsettingsswitchcamkey_Checked" Unchecked="cbsettingsswitchcamkey_Checked"/>
                                            </Grid>
                                            <Grid Style="{StaticResource FormRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="46"/>
                                            </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource FormLabel}" Text="{Binding Translation[oldcreatorrefresh], FallbackValue=Old Creator Refresh}"/>
                                                <CheckBox x:Name="cbsettingsoldcreatorrefresh" Grid.Column="1" Style="{StaticResource FormToggle}"/>
                                            </Grid>
                                            <TextBlock Margin="0,26,0,10" Foreground="{DynamicResource TextColor}" FontSize="30" FontWeight="Bold"
                                                       Text="{Binding Translation[logging], FallbackValue=Logging}" TextTrimming="CharacterEllipsis"/>
                                            <Border Background="Transparent" Margin="0,0,0,8" Height="44">
                                                <ComboBox x:Name="ddsettingsloglevel" FontFamily="{DynamicResource Volte}" SelectionChanged="ddsettingsloglevel_SelectionChanged"
                                                          Tag="{Binding Translation[settingsloglevel], FallbackValue=Log Level}">
                                                    <ComboBoxItem Content="Trace"/>
                                                    <ComboBoxItem Content="Debug"/>
                                                    <ComboBoxItem Content="Info"/>
                                                    <ComboBoxItem Content="Warn" Selector.IsSelected="True"/>
                                                    <ComboBoxItem Content="Error"/>
                                                    <ComboBoxItem Content="Fatal"/>
                                                </ComboBox>
                                            </Border>
                                            <Grid Style="{StaticResource FormRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="46"/>
                                            </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource FormLabel}" Text="{Binding Translation[writelogstofile], FallbackValue=Write Logs to File}"/>
                                                <CheckBox x:Name="cbsettingswritelogstofile" Grid.Column="1" Style="{StaticResource FormToggle}" Checked="cbsettingswritelogstofile_Checked" Unchecked="cbsettingswritelogstofile_Checked"/>
                                            </Grid>
                                            <Grid Style="{StaticResource FormRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="46"/>
                                            </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource FormLabel}" Text="{Binding Translation[hidegtamessage], FallbackValue=Hide Start GTA Message}"/>
                                                <CheckBox x:Name="cbsettingshidegtamessage" Grid.Column="1" Style="{StaticResource FormToggle}" Checked="cbsettingshidegtamessage_Checked" Unchecked="cbsettingshidegtamessage_Checked"/>
                                            </Grid>
                                            <Grid Style="{StaticResource FormRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="46"/>
                                            </Grid.ColumnDefinitions>
