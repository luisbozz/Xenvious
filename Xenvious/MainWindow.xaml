                                                    <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="{DynamicResource ShadowColor}"/></Border.Effect>
                                                    <Button x:Name="BtnCheckUpdates" Style="{DynamicResource CustomButton}" local:CornerRadiusSetter.CornerRadius="5" FontSize="14" Padding="12,0" Foreground="{DynamicResource TextColor}" Click="BtnCheckUpdates_Click" Content="{Binding Translation[update_check_now], FallbackValue=Nach Updates suchen}"/>
                                                </Border>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                            <TextBlock Margin="0,0,0,10" Foreground="{DynamicResource TextColor}" FontSize="30" FontWeight="Bold"
                                                       Text="{Binding Translation[hlinks], FallbackValue=Helpful links}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Margin="0,0,0,6" Height="36" VerticalAlignment="Center">
                                                <Hyperlink x:Name="links_props" Style="{StaticResource SettingsLink}" RequestNavigate="OpenLinkSettings">
                                                    <InlineUIContainer>
                                                        <TextBlock Style="{StaticResource SettingsLinkText}" Text="{Binding Translation[props], FallbackValue=Props}"/>
                                                    </InlineUIContainer>
                                                </Hyperlink>
                                            </TextBlock>
                                            <TextBlock Margin="0,0,0,6" Height="36" VerticalAlignment="Center">
                                                <Hyperlink x:Name="links_propswp" Style="{StaticResource SettingsLink}" RequestNavigate="OpenLinkSettings">
                                                    <InlineUIContainer>
                                                        <TextBlock Style="{StaticResource SettingsLinkText}" Text="{Binding Translation[propswp], FallbackValue=Props + Pictures}"/>
                                                    </InlineUIContainer>
                                                </Hyperlink>
                                            </TextBlock>
                                            <TextBlock Margin="0,0,0,6" Height="36" VerticalAlignment="Center">
                                                <Hyperlink x:Name="links_veh" Style="{StaticResource SettingsLink}" RequestNavigate="OpenLinkSettings">
                                                    <InlineUIContainer>
                                                        <TextBlock Style="{StaticResource SettingsLinkText}" Text="{Binding Translation[vehicles], FallbackValue=Vehicles}"/>
                                                    </InlineUIContainer>
                                                </Hyperlink>
                                            </TextBlock>
                                            <TextBlock Margin="0,0,0,6" Height="36" VerticalAlignment="Center">
                                                <Hyperlink x:Name="links_weap" Style="{StaticResource SettingsLink}" RequestNavigate="OpenLinkSettings">
                                                    <InlineUIContainer>
                                                        <TextBlock Style="{StaticResource SettingsLinkText}" Text="{Binding Translation[weapons], FallbackValue=Weapons}"/>
                                                    </InlineUIContainer>
                                                </Hyperlink>
                                            </TextBlock>
                                            <TextBlock Margin="0,0,0,6" Height="36" VerticalAlignment="Center">
                                                <Hyperlink x:Name="links_peds" Style="{StaticResource SettingsLink}" RequestNavigate="OpenLinkSettings">
                                                    <InlineUIContainer>
                                                        <TextBlock Style="{StaticResource SettingsLinkText}" Text="{Binding Translation[actor], FallbackValue=Actor}"/>
                                                    </InlineUIContainer>
                                                </Hyperlink>
                                            </TextBlock>
                                            <TextBlock Margin="0,0,0,6" Height="36" VerticalAlignment="Center">
                                                <Hyperlink x:Name="links_cc" Style="{StaticResource SettingsLink}" RequestNavigate="OpenLinkSettings">
                                                    <InlineUIContainer>
                                                        <TextBlock Style="{StaticResource SettingsLinkText}" Text="{Binding Translation[link_cc], FallbackValue=Color Codes}"/>
                                                    </InlineUIContainer>
                                                </Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                    </TabItem>

                    <TabItem x:Name="PageMod" Header="Misc" Height="25" VerticalAlignment="Top">

                        <Border Grid.Column="1" Background="{DynamicResource SectionBackgroundBrush}" CornerRadius="15" Padding="0,0,0,5" Margin="10"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="13" ShadowDepth="0" Color="{DynamicResource ShadowColor}"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Margin="3" CornerRadius="15" Background="{DynamicResource SeactionHeaderBackgroundBrush}" Grid.Row="0">
                                    <Viewbox VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Label Foreground="{DynamicResource TextColor}" FontFamily="{DynamicResource Volte}" FontWeight="Bold" Content="Misc"/>
                                    </Viewbox>
                                </Border>

                                <Grid Margin="10 0" Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Margin="10" BorderThickness="1" CornerRadius="5" BorderBrush="{DynamicResource SectionBackgroundBrush}" Background="{DynamicResource SectionBackgroundBrush}" MinHeight="225" MinWidth="175">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="{DynamicResource ShadowColor}"/>                                        </Border.Effect>
                                        <Grid>
                                            <!--Bottom-->
                                            <!-- Pages in three groups; PageInnerMod_SelectionChanged marks the open one. -->
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="8,0,8,5">
                                                <TextBlock Style="{StaticResource SideNavGroup}" Text="{Binding Translation[misc_grp_jobs], FallbackValue='Jobs'}"/>
                                                <Button x:Name="BtnModMapBackup" Style="{StaticResource SideNavButton}" Click="BtnModMapBackup_Click">
                                                    <TextBlock Style="{StaticResource NavLabel}" Text="{Binding Translation[map_backup], FallbackValue='Job Backup'}"/>
                                                </Button>
                                                <Button x:Name="BtnModJobLinks" Style="{StaticResource SideNavButton}" Click="BtnModJobLinks_Click">
                                                    <TextBlock Style="{StaticResource NavLabel}" Text="{Binding Translation[misc_jobslots], FallbackValue='Job Slots'}"/>
                                                </Button>
                                                <Button x:Name="BtnModMapMover" Style="{StaticResource SideNavButton}" Click="BtnModMapMover_Click">
                                                    <TextBlock Style="{StaticResource NavLabel}" Text="{Binding Translation[misc_jobmove], FallbackValue='Move Job'}"/>
                                                </Button>
                                                <TextBlock Style="{StaticResource SideNavGroup}" Text="{Binding Translation[misc_grp_creator], FallbackValue='Creator'}"/>
                                                <Button x:Name="BtnModMS" Style="{StaticResource SideNavButton}" Click="BtnMS_Click">
                                                    <TextBlock Style="{StaticResource NavLabel}" Text="{Binding Translation[misc_menupresets], FallbackValue='Menu Presets'}"/>
                                                </Button>
                                                <Button x:Name="BtnModScrPatches" Style="{StaticResource SideNavButton}" Click="BtnModScrPatches_Click">
                                                    <TextBlock Style="{StaticResource NavLabel}" Text="{Binding Translation[misc_scrpatches], FallbackValue='Script Patches'}"/>
                                                </Button>
                                                <Button x:Name="BtnModTools" Style="{StaticResource SideNavButton}" Click="BtnModTools_Click">
                                                    <TextBlock Style="{StaticResource NavLabel}" Text="{Binding Translation[misc_creatortools], FallbackValue='Creator Tools'}"/>
                                                </Button>
                                                <TextBlock Style="{StaticResource SideNavGroup}" Text="{Binding Translation[misc_grp_dev], FallbackValue='Development'}"/>
                                                <Button x:Name="BtnModLogs" Style="{StaticResource SideNavButton}" Click="BtnModLogs_Click">
                                                    <TextBlock Style="{StaticResource NavLabel}" Text="{Binding Translation[logs], FallbackValue='Logs'}"/>
                                                </Button>
                                                <Button x:Name="BtnModStuff" Style="{StaticResource SideNavButton}" Click="BtnModStuff_Click">
                                                    <TextBlock Style="{StaticResource NavLabel}" Text="{Binding Translation[misc_diagnostics], FallbackValue='Diagnostics'}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Rectangle Grid.Column="1" HorizontalAlignment="center" VerticalAlignment="Stretch" Fill="DimGray" Width="1"/>

                                    <TabControl x:Name="PageInnerMod" SelectionChanged="PageInnerMod_SelectionChanged" Background="Transparent" BorderThickness="0" Grid.Column="2" Margin="10,0,0,0">

                                        <TabItem x:Name="PageInnerModMapMover" Header="Map Mover">

                                            <Grid Margin="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Karte. Klick setzt das Ziel, Mausrad zoomt. -->
                                                <Border Grid.Column="0" CornerRadius="10" Margin="0,0,15,0" VerticalAlignment="Top"
                                                        Background="{DynamicResource SectionBackgroundBrush}" Padding="8">
                                                    <StackPanel>
                                                        <ScrollViewer x:Name="scrollMapMover" Width="420" Height="560"
                                                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                                                      PreviewMouseWheel="MapMoverMap_Wheel">
                                                            <Grid x:Name="gridMapMoverCanvas" Width="420" Height="578"
                                                                  MouseLeftButtonDown="MapMoverMap_Click" MouseMove="MapMoverMap_Move" Cursor="Cross">
                                                                <Grid.LayoutTransform>
                                                                    <ScaleTransform x:Name="mapMoverZoom" ScaleX="1" ScaleY="1"/>
                                                                </Grid.LayoutTransform>
                                                                <Image Source="/Images/gtav_map.jpg" Stretch="Fill"/>
                                                                <Canvas x:Name="canvasMapMover" Background="Transparent"/>
                                                            </Grid>
                                                        </ScrollViewer>

                                                        <Grid Margin="0,8,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="tbmapmoverhover" Grid.Column="0" FontSize="13" Opacity="0.7"
                                                                       VerticalAlignment="Center" Text="Klick setzt das Ziel, Mausrad zoomt"/>
                                                            <Button x:Name="BtnMapMoverCalib" Grid.Column="1" Style="{DynamicResource CustomButton}"
                                                                    Content="Kalibrieren" FontSize="13" Width="110" Height="26"
                                                                    Background="{DynamicResource ButtonHoverBackgroundBrush}"
                                                                    local:CornerRadiusSetter.CornerRadius="5" Click="BtnMapMoverCalib_Click"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Top">

                                                    <!-- Ziel -->
                                                    <Border CornerRadius="10" Padding="15,12" Margin="0,0,0,12"
                                                            Background="{DynamicResource SectionBackgroundBrush}">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" Text="Ziel"/>
                                                                <Button x:Name="BtnMapMoverToCam" Grid.Column="1" Style="{DynamicResource CustomButton}"
                                                                        Content="Position aus GTA uebernehmen" FontSize="14" Height="32" Margin="15,0,0,0"
                                                                        HorizontalAlignment="Stretch" Background="{DynamicResource ButtonHoverBackgroundBrush}"
                                                                        local:CornerRadiusSetter.CornerRadius="5" Click="BtnMapMoverToCam_Click"/>
                                                            </Grid>
                                                            <TextBlock x:Name="tbmapmoverto" FontSize="17" Opacity="0.85" Text="noch nicht gesetzt"/>
                                                            <Rectangle Height="1" Fill="DimGray" Margin="0,10"/>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" FontSize="15" VerticalAlignment="Center" Opacity="0.7" Text="Start (Mitte des Jobs)"/>
                                                                <TextBlock x:Name="tbmapmoverfrom" Grid.Column="1" FontSize="15" Opacity="0.7"
                                                                           HorizontalAlignment="Right" Text="--"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Versatz -->
                                                    <Border CornerRadius="10" Padding="15,12" Margin="0,0,0,12"
                                                            Background="{DynamicResource SectionBackgroundBrush}">
                                                        <StackPanel>
                                                            <TextBlock FontSize="19" FontWeight="Bold" Margin="0,0,0,8" Text="Versatz"/>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox x:Name="tbmapmoverdx" Grid.Column="0" Style="{StaticResource Watermark}" Tag="X"
                                                                         Height="36" Margin="0,0,5,0" Text="0" KeyDown="FormatTextForFloat"
                                                                         TextChanged="MapMoverDelta_Changed"/>
                                                                <TextBox x:Name="tbmapmoverdy" Grid.Column="1" Style="{StaticResource Watermark}" Tag="Y"
                                                                         Height="36" Margin="5,0" Text="0" KeyDown="FormatTextForFloat"
                                                                         TextChanged="MapMoverDelta_Changed"/>
                                                                <TextBox x:Name="tbmapmoverdz" Grid.Column="2" Style="{StaticResource Watermark}" Tag="Z"
                                                                         Height="36" Margin="5,0,0,0" Text="0" KeyDown="FormatTextForFloat"
                                                                         TextChanged="MapMoverDelta_Changed"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Was mitkommt -->
                                                    <Border CornerRadius="10" Padding="15,12" Margin="0,0,0,12"
                                                            Background="{DynamicResource SectionBackgroundBrush}">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" Text="Was mitkommt"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                    <Button x:Name="BtnMapMoverAll" Style="{DynamicResource CustomButton}" Content="Alle" FontSize="13"
                                                                            Width="60" Height="26" Margin="0,0,5,0" Background="{DynamicResource ButtonHoverBackgroundBrush}"
                                                                            local:CornerRadiusSetter.CornerRadius="5" Click="BtnMapMoverAll_Click"/>
                                                                    <Button x:Name="BtnMapMoverNone" Style="{DynamicResource CustomButton}" Content="Keine" FontSize="13"
                                                                            Width="60" Height="26" Background="{DynamicResource ButtonHoverBackgroundBrush}"
                                                                            local:CornerRadiusSetter.CornerRadius="5" Click="BtnMapMoverNone_Click"/>
                                                                </StackPanel>
                                                            </Grid>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="30"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel x:Name="panelMapMoverFamiliesLeft" Grid.Column="0"/>
                                                                <StackPanel x:Name="panelMapMoverFamiliesRight" Grid.Column="2"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Ausfuehren -->
                                                    <Border CornerRadius="10" Padding="15,12" Margin="0,0,0,12"
                                                            Background="{DynamicResource SectionBackgroundBrush}">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                                <Button x:Name="BtnMapMoverApply" Style="{DynamicResource CustomButton}" Content="Verschieben"
                                                                        FontSize="18" Width="170" Height="42" Margin="0,0,10,0"
                                                                        Background="{DynamicResource ButtonHoverBackgroundBrush}"
                                                                        local:CornerRadiusSetter.CornerRadius="6" Click="BtnMapMoverApply_Click"/>
                                                                <Button x:Name="BtnMapMoverUndo" Style="{DynamicResource CustomButton}" Content="Rueckgaengig"
                                                                        FontSize="16" Width="150" Height="42" IsEnabled="False"
                                                                        Background="{DynamicResource SectionBackgroundBrush}"
                                                                        local:CornerRadiusSetter.CornerRadius="6" Click="BtnMapMoverUndo_Click"/>
                                                            </StackPanel>
                                                            <TextBlock x:Name="tbmapmoverstatus" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.85" Text=""/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Kurzanleitung -->
                                                    <Border CornerRadius="10" Padding="15,12" Background="{DynamicResource SectionBackgroundBrush}">
                                                        <StackPanel>
                                                            <TextBlock FontSize="17" FontWeight="Bold" Margin="0,0,0,6" Text="Kurz erklaert"/>
                                                            <TextBlock FontSize="13" Opacity="0.75" TextWrapping="Wrap" LineHeight="19" Text="Der Map Mover verschiebt einen ganzen Job an eine andere Stelle. Start ist immer die Mitte dessen, was gerade geladen und angehakt ist -- das rechnet Xenvious selbst aus. Du legst nur das Ziel fest: auf die Karte klicken, oder in GTA mit der Creator-Kamera hinfliegen und die Position uebernehmen."/>
                                                            <TextBlock FontSize="13" Opacity="0.75" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0" Text="Z bleibt bei 0, solange du nichts eintraegst. Ein Kartenklick kennt keine Hoehe; die Kamera-Position schon, dann steht der Hoehenunterschied im Z-Feld. GTAs Gelaende ist nicht flach -- pruefe nach dem Verschieben, ob nichts im Hang steckt, und korrigiere Z von Hand."/>
                                                            <TextBlock FontSize="13" Opacity="0.75" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0" Text="Geschrieben wird direkt in den laufenden Job. Rueckgaengig macht genau den letzten Versatz wieder weg -- teste es erst an einem Job, den du nicht brauchst."/>
                                                            <TextBlock FontSize="13" Opacity="0.75" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0" Text="Increment Size ist etwas anderes: die Schrittweite fuer Strg+Umschalt und +/- in einem Positionsfeld."/>
                                                            <Grid Margin="0,10,0,0" Width="220" HorizontalAlignment="Left">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="90"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" FontSize="15" VerticalAlignment="Center" Text="Increment Size"/>
                                                                <TextBox x:Name="tbsettingsincrementsize" Grid.Column="1" Height="32" IsEnabled="True"
                                                                         VerticalContentAlignment="Center" TextAlignment="Center"
                                                                         TextChanged="tbsettingsincrementsize_TextChanged" KeyDown="FormatTextForFloat"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                </StackPanel>
                                            </Grid>
                                        </TabItem>

                                        <TabItem x:Name="PageInnerModJL" Header="Job Links">

                                            <ScrollViewer VerticalScrollBarVisibility="Auto">

                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" >
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="50"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Column="1" Margin="5 10" Background="Transparent" Width="200">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="{DynamicResource ShadowColor}"/>    
                                                        </Border.Effect>
                                                        <ComboBox x:Name="ddjoblinks" FontFamily="{DynamicResource Volte}" SelectionChanged="ddjoblinks_SelectionChanged">
                                                            <ComboBoxItem Content="Published" Selector.IsSelected="True" />
                                                            <ComboBoxItem Content="Saved"/>
                                                        </ComboBox>
                                                    </Border>

                                                    <WrapPanel Orientation="Horizontal" Grid.Row="1">

                                                        <Grid Width="290" Height="auto" Margin="0,0,10,0">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="35"/>
                                                                <RowDefinition Height="35"/>
                                                                <RowDefinition Height="35"/>
                                                                <RowDefinition Height="35"/>
                                                                <RowDefinition Height="35"/>
                                                                <RowDefinition Height="35"/>
                                                                <RowDefinition Height="35"/>
                                                                <RowDefinition Height="35"/>
                                                                <RowDefinition Height="35"/>
                                                                <RowDefinition Height="35"/>
                                                            </Grid.RowDefinitions>

