                                            </Grid>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource DashCard}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource DashCardHeader}">
                                            <TextBlock Style="{StaticResource DashCardTitle}" Text="{Binding Translation[set_creator], FallbackValue=Creator}"/>
                                        </Border>
                                        <StackPanel Margin="14,10,14,12">
                                            <Grid Style="{StaticResource FormRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="46"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource FormLabel}" Text="{Binding Translation[settingslva], FallbackValue=Load values anyway}"/>
