                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="5" Background="{DynamicResource SeactionHeaderBackgroundBrush}" Padding="14,12" Margin="0,0,8,8" MaxWidth="760" HorizontalAlignment="Left">
                                                                <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.6" Color="{DynamicResource ShadowColor}"/></Border.Effect>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="36"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox VerticalAlignment="Top" Margin="0,2,0,0" IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                                                                    <StackPanel Grid.Column="1">
                                                                        <TextBlock Foreground="{DynamicResource TextColor}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding Name}"/>
                                                                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" Text="{Binding Description}"
                                                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                        <ItemsControl ItemsSource="{Binding Tags}" Margin="0,8,0,0">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Border CornerRadius="9" Background="{DynamicResource HoverBackgroundBrush}" Padding="8,2" Margin="0,0,6,4">
                                                                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource HighlightBrush}"/>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </TabItem>

                    <TabItem x:Name="PageMenuSwitcher" Header="Menu Switcher">
                        <!-- Jump the creator to any menu by its id, and keep often used menus as presets. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20,10" HorizontalAlignment="Left" Width="720">
                                <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextColor}" Text="{Binding Translation[misc_menupresets], FallbackValue='Menu Presets'}"/>
                                <TextBlock FontSize="13" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,14" TextWrapping="Wrap"
                                           Text="{Binding Translation[ms_help], FallbackValue='Read the menu the creator shows, switch it to another one, or save it as a preset.'}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{DynamicResource SectionBackgroundBrush}" CornerRadius="6" Padding="14,12" VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10" Text="{Binding Translation[ms_current], FallbackValue='Current menu'}"/>
                                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,3" Text="Menu ID"/>
                                            <TextBox x:Name="tbmscurr" Style="{StaticResource Watermark}" Height="32" ToolTip="f_267" Margin="0,0,0,8" KeyDown="FormatTextForInteger"/>
                                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,3" Text="Return Menu ID"/>
                                            <TextBox x:Name="tbmsprev" Style="{StaticResource Watermark}" Height="32" ToolTip="f_268" Margin="0,0,0,12" KeyDown="FormatTextForInteger"/>
                                            <UniformGrid Columns="2">
                                                <Button x:Name="Btnmsread" Style="{StaticResource FormButton}" Margin="0,0,4,0" Click="Btnmsread_Click" Content="{Binding Translation[ms_read], FallbackValue=Read}"/>
                                                <Button x:Name="Btnmschange" Style="{StaticResource FormButton}" Margin="4,0,0,0" Background="{DynamicResource PrimaryButtonBackground}" Foreground="{DynamicResource HighlightForeground}" Click="Btnmschange_Click" Content="{Binding Translation[ms_set], FallbackValue=Switch}"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="{DynamicResource SectionBackgroundBrush}" CornerRadius="6" Padding="14,12" VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,10" Text="Presets"/>
                                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,3" Text="{Binding Translation[ms_saved], FallbackValue='Saved presets'}"/>
                                            <ComboBox x:Name="cbmsPresets" Height="32" Margin="0,0,0,8"
                                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=MenuSwitcherPresets}"
                                                      DisplayMemberPath="Name" SelectedValuePath="MenuId" SelectionChanged="cbmsPresets_SelectionChanged"/>
                                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,3" Text="Name"/>
                                            <TextBox x:Name="tbmsPresetName" Style="{StaticResource Watermark}" Height="32" Margin="0,0,0,12"/>
                                            <UniformGrid Columns="3">
                                                <Button x:Name="BtnmsAddPreset" Style="{StaticResource FormButton}" Margin="0,0,4,0" Click="BtnmsAddPreset_Click" Content="{Binding Translation[ms_add], FallbackValue=New}"/>
                                                <Button x:Name="BtnmsSavePreset" Style="{StaticResource FormButton}" Margin="4,0,4,0" Click="BtnmsSavePreset_Click" Content="{Binding Translation[ms_save], FallbackValue=Save}"/>
                                                <Button x:Name="BtnmsDeletePreset" Style="{StaticResource FormButtonDanger}" Margin="4,0,0,0" Click="BtnmsDeletePreset_Click" Content="{Binding Translation[ms_delete], FallbackValue=Delete}"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                                    </TabControl>
                                </Grid>

                            </Grid>
                        </Border>

                    </TabItem>

                    <TabItem x:Name="PageCopyJobs" Header="Copy Jobs">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="20,14" MaxWidth="1000">
                                <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextColor}" Text="{Binding Translation[copyjobs], FallbackValue='Copy Jobs'}"/>
                                <TextBlock FontSize="13" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Translation[copy_help], FallbackValue='Lädt einen Job über seinen Social-Club-Link und schreibt die ausgewählten Teile in den offenen Creator. Funktioniert auch mit Rockstar-Jobs und Jobs von der Konsole, kopieren lässt sich nur auf den PC.'}"/>

                                <!-- Two ways to copy: through the Social Club link, or the older nrcid route
                                     that goes through a published capture. -->
                                <Border Style="{StaticResource NavGroup}" HorizontalAlignment="Left" Margin="0,14,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnCopyModeLink" Style="{StaticResource NavButton}" Tag="active" Click="BtnCopyModeLink_Click">
                                            <TextBlock Style="{StaticResource NavLabel}" Text="{Binding Translation[copy_mode_link], FallbackValue='Via link'}"/>
                                        </Button>
                                        <Button x:Name="BtnCopyModeNrcid" Style="{StaticResource NavButton}" Click="BtnCopyModeNrcid_Click">
                                            <TextBlock Style="{StaticResource NavLabel}" Text="{Binding Translation[copy_mode_nrcid], FallbackValue='Via nrcid'}"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <StackPanel x:Name="CopyNrcidPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                                    <Grid Width="290" Margin="10">

                                        <StackPanel>

                                            <Label VerticalAlignment="Center" Foreground="{DynamicResource TextColor}" FontSize="22" Content="{Binding Translation[step], FallbackValue=Step}" ContentStringFormat="{}{0} 1"  FontWeight="Bold" Height="35"/>

                                            <TextBlock VerticalAlignment="Center" Foreground="Red" FontSize="13" Text="Please make sure you enter a Capture first before you continue." TextWrapping="Wrap" />
                                            <TextBlock VerticalAlignment="Center" Foreground="Red" FontSize="13" Text="Set a Location for the Start Point that is close to the Start Point of the Job you want to Copy!" TextWrapping="Wrap" />


                                            <Grid Grid.Row="0">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="0.88*"/>
                                                    <ColumnDefinition Width="0.12*"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="43"/>
                                                    <RowDefinition Height="33"/>
                                                    <RowDefinition Height="33"/>
                                                    <RowDefinition Height="33"/>
                                                </Grid.RowDefinitions>

                                                
                                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}" FontSize="22" Text="{Binding Translation[start], FallbackValue=Start}" FontWeight="Bold"/>

                                                <TextBox x:Name="tbnrcidjcstartlocx" Grid.Row="1" Style="{StaticResource Watermark}" Tag="{Binding Translation[vector3x], FallbackValue=X-Component}" Height="30" Margin="0,0,5,0" TextChanged="tbnrcidjcstartlocx_TextChanged" KeyDown="FormatTextForFloat"/>
                                                <TextBox x:Name="tbnrcidjcstartlocy" Grid.Row="2" Style="{StaticResource Watermark}" Tag="{Binding Translation[vector3y], FallbackValue=Y-Component}" Height="30" Margin="0,0,5,0" TextChanged="tbnrcidjcstartlocy_TextChanged" KeyDown="FormatTextForFloat"/>
                                                <TextBox x:Name="tbnrcidjcstartlocz" Grid.Row="3" Style="{StaticResource Watermark}" Tag="{Binding Translation[vector3z], FallbackValue=Z-Component}" Height="30" Margin="0,0,5,0" TextChanged="tbnrcidjcstartlocz_TextChanged" KeyDown="FormatTextForFloat"/>
                                                <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="3" CornerRadius="5" Background="{DynamicResource SectionBackgroundBrush}" Margin="5">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="{DynamicResource ShadowColor}"/>                
                                                    </Border.Effect>

                                                    <Button x:Name="Btnnrcidjcgetloc" Style="{DynamicResource TitleBarButton}" Click="Btnnrcidjcgetloc_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{Binding Translation[getcursorloc], FallbackValue=Get Cursor Location}" >
                                                        <Path Data="M 12 12 L 12 0 L 6 6 Z" Stretch="Uniform" Stroke="{DynamicResource TextColor}" />
                                                    </Button>
                                                </Border>

                                            </Grid>

                                            <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Fill="{DynamicResource FaintTextBrush}" Height="1" Margin="20,8,20,8" />

                                            <TextBlock VerticalAlignment="Center" Foreground="Red" FontSize="13" Text="Insert a Job Link here please that you want to Copy. Also Input how you want to load the Job in nrmtt. (1 = Loading Screen / 2 = Blackscreen)" TextWrapping="Wrap" />


                                            <Grid Grid.Row="3" Visibility="{Binding ElementName=ddmissionnrcidno, Path=Visibility}">

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="38"/>
                                                    <RowDefinition Height="33"/>
                                                    <RowDefinition Height="33"/>
                                                </Grid.RowDefinitions>

                                                
                                                <Border Grid.Row="0"  Background="Transparent" Margin="0,0,0,5" Height="30">
                                                    <ComboBox x:Name="ddnrcidjcno" FontFamily="{DynamicResource Volte}" SelectionChanged="ddnrcidjcno_SelectionChanged" Tag="{Binding Translation[number], FallbackValue=Number}">
                                                        <ComboBoxItem Content="1"/>
                                                        <ComboBoxItem Content="2"/>
                                                        <ComboBoxItem Content="3"/>
                                                        <ComboBoxItem Content="4"/>
                                                        <ComboBoxItem Content="5"/>
                                                        <ComboBoxItem Content="6"/>
                                                    </ComboBox>
                                                </Border>

                                                <TextBox x:Name="tbnrcidjc" Grid.Row="1" Style="{StaticResource Watermark}" Tag="{Binding Translation[nrcid], FallbackValue=nrcid}" Height="30" Margin="0,0,5,0" TextChanged="tbnrcidjc_TextChanged" />
                                                <TextBox x:Name="tbnrmttjc" Grid.Row="2" Style="{StaticResource Watermark}" Tag="{Binding Translation[nrmtt], FallbackValue=nrmtt}" Height="30" Margin="0,0,5,0" TextChanged="tbnrmttjc_TextChanged" />


                                            </Grid>
                                            
                                            <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Fill="{DynamicResource FaintTextBrush}" Height="1" Margin="20,8,20,8" />

                                            <TextBlock VerticalAlignment="Center" Foreground="Red" FontSize="13" Text="This will set some values for the Job so that Job Copy works. (You dont need to use this if youve done the steps yourself)" TextWrapping="Wrap" />

                                            <Border CornerRadius="5" Background="{DynamicResource SectionBackgroundBrush}" Margin="5" >
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="{DynamicResource ShadowColor}"/>            
                                                </Border.Effect>
                                                <Button x:Name="Btnnrcidprep" Style="{DynamicResource CustomButton}" Content="Perpare Job" local:CornerRadiusSetter.CornerRadius="5" Click="Btnnrcidprep_Click" />
                                            </Border>

                                            <TextBlock VerticalAlignment="Center" Foreground="Red" FontSize="13" Text="Now you can publish your job. You might need to force Publish or use the Save/Publish function under Dashboard." TextWrapping="Wrap" />


                                        </StackPanel>
                                        
                                    </Grid>
                                    <Grid Width="290" Margin="10">

                                        <StackPanel>
                                            <Label VerticalAlignment="Center" Foreground="{DynamicResource TextColor}" FontSize="22" Content="{Binding Translation[step], FallbackValue=Step}" ContentStringFormat="{}{0} 2"  FontWeight="Bold" Height="35"/>

                                            <TextBlock VerticalAlignment="Center" Foreground="Red" FontSize="13" Text="Please start your job first before you continue!" TextWrapping="Wrap" />
                                            
                                            <TextBox x:Name="tbnrcidcopycs" Grid.Row="0" Style="{StaticResource Watermark}" Tag="Creator Start" Height="30" Margin="0,0,0,5"/>
                                            <TextBox x:Name="tbnrcidcopyce" Grid.Row="0" Style="{StaticResource Watermark}" Tag="Creator End" Height="30" Margin="0,0,0,5" />
                                            
                                            <TextBlock VerticalAlignment="Center" Foreground="Red" FontSize="13" Text="Get the current address range of the Creator. Make sure you do this before you try to copy the values. (You can also define your own Range if you would like to only copy specific sections)" TextWrapping="Wrap" />

                                            <Border CornerRadius="5" Background="{DynamicResource SectionBackgroundBrush}" Margin="5" >
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="{DynamicResource ShadowColor}"/>            
                                                </Border.Effect>
                                                <Button x:Name="Btnnrcidgetcvalues" Style="{DynamicResource CustomButton}" Content="Get Creator Start/End" local:CornerRadiusSetter.CornerRadius="5" Click="Btnnrcidgetcvalues_Click" />
                                            </Border>
                                            
                                            <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Fill="{DynamicResource FaintTextBrush}" Height="1" Margin="20,8,20,8" />

                                            <TextBlock VerticalAlignment="Center" Foreground="Red" FontSize="13" Text="Use this first if the new Job has loaded. This will Copy all bytes in the defined Range into Xenvious. Now you can leave the Job and continue with step 3." TextWrapping="Wrap" />

                                            <Border CornerRadius="5" Background="{DynamicResource SectionBackgroundBrush}" Margin="5" >
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="{DynamicResource ShadowColor}"/>            
                                                </Border.Effect>
                                                <Button x:Name="Btnnrcidcopy" Style="{DynamicResource CustomButton}" Content="Copy Values" local:CornerRadiusSetter.CornerRadius="5" Click="Btnnrcidcopy_Click" />
                                            </Border>

                                        </StackPanel>
                                        
                                    </Grid>
                                    <Grid Width="290" Margin="10">
                                        <StackPanel>
                                            <Label VerticalAlignment="Center" Foreground="{DynamicResource TextColor}" FontSize="22" Content="{Binding Translation[step], FallbackValue=Step}" ContentStringFormat="{}{0} 3"  FontWeight="Bold" Height="35"/>
                                            <TextBlock VerticalAlignment="Center" Foreground="Red" FontSize="13" Text="Please enter Creator again and go into a empty job of the jobtype of the Job you wanted to copy to continue with restoring." TextWrapping="Wrap" />

                                            <Border CornerRadius="5" Background="{DynamicResource SectionBackgroundBrush}" Margin="5" >
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="{DynamicResource ShadowColor}"/>            
                                                </Border.Effect>
                                                <Button x:Name="Btnnrcidrestore" Style="{DynamicResource CustomButton}" Content="Restore" local:CornerRadiusSetter.CornerRadius="5" Click="Btnnrcidrestore_Click" />
                                            </Border>

                                            <Label VerticalAlignment="Center" Foreground="{DynamicResource TextColor}" FontSize="22" Content="Disclaimer" ContentStringFormat="{}{0} 3"  FontWeight="Bold" Height="35"/>
                                            <TextBlock VerticalAlignment="Center" Foreground="Red" FontSize="13" Text="Please enter Creator again and go into a empty job of the jobtype of the Job you wanted to copy to continue with restoring." TextWrapping="Wrap" />

                                        </StackPanel>
                                        
                                    </Grid>
                                    
                                </WrapPanel>
                                </StackPanel>

                                <StackPanel x:Name="CopyLinkPanel">
                                <!-- Link -->
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="tbCopyJobLink" Height="38" Style="{StaticResource Watermark}" FontSize="15" Tag="Job Link" ToolTip="Social-Club-Link oder Job-ID, Enter lädt den Job." KeyDown="tbCopyJobLink_KeyDown" MouseDoubleClick="tbCopyJobLink_MouseDoubleClick"/>
                                    <Border Grid.Column="1" CornerRadius="5" Background="{DynamicResource SectionBackgroundBrush}" Margin="10,0,0,0" Height="38" MinWidth="110">
                                        <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="{DynamicResource ShadowColor}"/></Border.Effect>
                                        <Button x:Name="BtnCopyJobLoad" Style="{DynamicResource CustomButton}" local:CornerRadiusSetter.CornerRadius="5" FontSize="15" Foreground="{DynamicResource TextColor}" Click="BtnCopyJobLoad_Click" Content="Laden"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="tbCopyStatus" FontSize="13" Foreground="{DynamicResource HighlightBrush}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                                <!-- Job preview: greyed out until a job is loaded -->
                                <Grid Margin="0,14,0,0">
                                    <Border x:Name="CopyInnerContent" CornerRadius="5" Background="{DynamicResource SeactionHeaderBackgroundBrush}" Padding="14" IsEnabled="False" Opacity="0.35">
                                        <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.6" Color="{DynamicResource ShadowColor}"/></Border.Effect>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="300"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="200"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Image, below it who made the job and how it is received. -->
                                            <StackPanel Grid.Column="0">
                                                <Border CornerRadius="4" Background="{DynamicResource SectionBackgroundBrush}" Height="169" ClipToBounds="True">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Translation[copy_noimage], FallbackValue='Kein Bild'}" FontSize="13" Foreground="{DynamicResource FaintTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image x:Name="imgCopyJobImage" Stretch="UniformToFill" Cursor="Hand" MouseLeftButtonUp="imgCopyJobImage_MouseLeftButtonUp" Style="{StaticResource PopupImage}"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel x:Name="CopyMeta" Margin="0,10,0,0" Visibility="Collapsed">
                                                    <TextBlock x:Name="tbCopyCreator" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextColor}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="tbCopyCreated" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,6"/>
                                                    <DockPanel>
                                                        <TextBlock x:Name="tbCopyLiked" DockPanel.Dock="Right" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                                                        <TextBlock x:Name="tbCopyPlayed" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                                                    </DockPanel>
                                                    <!-- Likes against dislikes. -->
                                                    <Grid Height="5" Margin="0,5,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition x:Name="CopyLikeShare" Width="1*"/>
                                                            <ColumnDefinition x:Name="CopyDislikeShare" Width="0*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{DynamicResource OkBrush}" CornerRadius="2,0,0,2"/>
                                                        <Border Grid.Column="1" Background="{DynamicResource BadBrush}" CornerRadius="0,2,2,0"/>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- Type, name, the whole description and the numbers that matter for this job type. -->
                                            <StackPanel Grid.Column="1" Margin="16,0,16,0">
                                                <Border HorizontalAlignment="Left" CornerRadius="3" Background="#33FAC828" Padding="8,1">
                                                    <Label x:Name="tbCopyJobType" FontSize="12" Padding="0" Foreground="{DynamicResource HighlightBrush}" Content="–"/>
                                                </Border>
                                                <TextBox x:Name="tbCopyName" Text="Job" Margin="0,6,0,0" FontSize="20" FontWeight="Bold" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextColor}" IsReadOnly="True" TextWrapping="Wrap"/>
                                                <TextBox x:Name="tbCopyDesc" Text="" Margin="0,4,0,0" FontSize="13" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource MutedTextBrush}" IsReadOnly="True" TextWrapping="Wrap"/>
                                                <!-- Tiles built in MainWindow.Misc.CopyJobs.cs; purple labels are specific to the job type. -->
                                                <UniformGrid x:Name="CopyStats" Columns="4" Margin="0,10,-8,0"/>
                                            </StackPanel>
                                            <!-- Where the objects are, from the coordinates in the job file. -->
                                            <StackPanel Grid.Column="2">
                                                <local:JobMap x:Name="CopyJobMap" Height="200"/>
                                                <WrapPanel x:Name="CopyMapLegend" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <li:LoadingIndicator x:Name="CopyAnimation" HorizontalAlignment="Center" VerticalAlignment="Center" Height="50" Width="50" SpeedRatio="{Binding SpeedRatio}" IsActive="{Binding IsArcsActive}" Visibility="Collapsed" Style="{DynamicResource LoadingIndicatorRingStyle}"/>
                                </Grid>

                                <!-- What to copy, and what happens afterwards -->
                                <Border x:Name="CopyOptions" CornerRadius="5" Background="{DynamicResource SeactionHeaderBackgroundBrush}" Padding="14" Margin="0,12,0,0" IsEnabled="False" Opacity="0.35">
                                    <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.6" Color="{DynamicResource ShadowColor}"/></Border.Effect>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}" Text="{Binding Translation[copy_what], FallbackValue='Kopieren'}"/>
                                            <ComboBox x:Name="ddCopyScope" Grid.Column="1" Width="230" Height="32" FontSize="14" VerticalContentAlignment="Center" FontFamily="{DynamicResource Volte}" SelectedIndex="0" SelectionChanged="DdCopyScope_SelectionChanged"/>
                                        </Grid>
                                        <TextBlock x:Name="tbCopyScopeHint" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                        <WrapPanel x:Name="CopyPartsPanel" Margin="0,10,0,0">
                                            <WrapPanel.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Margin" Value="6,0,18,8"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                                </Style>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                                </Style>
                                            </WrapPanel.Resources>
                                            <StackPanel Orientation="Horizontal"><CheckBox x:Name="cbCopyProps" IsChecked="True"/><TextBlock Text="Props"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><CheckBox x:Name="cbCopyDProps" IsChecked="True"/><TextBlock Text="Dynamic Props"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><CheckBox x:Name="cbCopyCP" IsChecked="True"/><TextBlock Text="Checkpoints"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><CheckBox x:Name="cbCopyTemplates" IsChecked="True"/><TextBlock Text="Templates"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><CheckBox x:Name="cbCopyDHProps" IsChecked="True"/><TextBlock Text="Fixtures"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><CheckBox x:Name="cbCopyImage" IsChecked="True"/><TextBlock Text="{Binding Translation[copy_opt_image], FallbackValue='Bild'}"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><CheckBox x:Name="cbCopyBasics"/><TextBlock Text="{Binding Translation[copy_opt_basics], FallbackValue='Grunddaten'}" ToolTip="Typ, Start, Kamera, Spielerzahl, Wetter, Uhrzeit, Verkehr"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><CheckBox x:Name="cbCopyGen"/><TextBlock Text="{Binding Translation[copy_opt_gen], FallbackValue='Name &amp; Beschreibung'}" ToolTip="Name, Beschreibung und weitere Angaben aus dem gen-Abschnitt"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><CheckBox x:Name="cbCopyMenubs"/><TextBlock Text="{Binding Translation[copy_opt_menubs], FallbackValue='Menü-Optionen'}" ToolTip="menubs 1–14: die Schalter der Creator-Menüs"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><CheckBox x:Name="cbCopyEndcon"/><TextBlock Text="{Binding Translation[copy_opt_endcon], FallbackValue='Endbedingungen'}" ToolTip="endcon: Regeln pro Team (irbs …)"/></StackPanel>
                                        </WrapPanel>
                                        <!-- "Does the job fit?": limits and the open creator, filled after loading. -->
                                        <Border CornerRadius="5" Background="{DynamicResource TextBoxBackground}" Padding="12,8" Margin="0,4,0,10">
                                            <StackPanel>
                                                <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource FaintTextBrush}" Text="{Binding Translation[copy_fits], FallbackValue='Does the job fit?'}"/>
                                                <StackPanel x:Name="CopyChecks" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding Translation[copy_after], FallbackValue='Danach:'}"/>
                                            <ComboBox x:Name="ddCopyJobMode" Grid.Column="2" Width="230" Height="34" FontSize="14" VerticalContentAlignment="Center" FontFamily="{DynamicResource Volte}" SelectedIndex="0"/>
                                            <Border Grid.Column="0" CornerRadius="5" Background="{DynamicResource SectionBackgroundBrush}" Height="34" Width="170" HorizontalAlignment="Left">
                                                <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="{DynamicResource ShadowColor}"/></Border.Effect>
                                                <Button x:Name="BtnCopyJob" Style="{DynamicResource CustomButton}" local:CornerRadiusSetter.CornerRadius="5" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource HighlightBrush}" Click="BtnCopyJob_Click" Content="{Binding Translation[copy_button], FallbackValue='In Creator kopieren'}"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="PageConverter" Header="Converter">

                        <!-- One input (name, number, 0x.., 0b..), the conversions, the 32 bits as byte tiles and the
                             model the value stands for, if it is in one of our lists. MainWindow.Converter.cs. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ConverterMain" Margin="20,16,20,16" MaxWidth="1000">
                                <StackPanel.Resources>
                                    <Style x:Key="ConvBit" TargetType="{x:Type ToggleButton}">
                                        <Setter Property="Height" Value="40"/>
                                        <Setter Property="Margin" Value="2"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                    <Border x:Name="bd" CornerRadius="4" BorderThickness="1" Background="{DynamicResource ComboBoxBackground}" BorderBrush="{DynamicResource ComboBoxBorder}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextColor}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </StackPanel.Resources>

                                <Border Style="{StaticResource DashCard}" Margin="0,0,0,12">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource DashCardHeader}">
                                            <DockPanel>
                                                <TextBlock Style="{StaticResource DashCardTitle}" Text="{Binding Translation[converter], FallbackValue=Converter}"/>
                                            </DockPanel>
                                        </Border>
                                        <StackPanel Margin="14,12,4,6">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Translation[conv_native], FallbackValue='Native, name or number'}"/>
                                            <TextBox x:Name="tbconvnative" Style="{StaticResource Watermark}" Height="40" FontSize="18" Margin="0,0,10,12" TextChanged="tbconvnative_TextChanged"/>
                                            <UniformGrid Columns="3" Margin="0,0,0,10">
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Translation[conv_int], FallbackValue=Integer}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBox x:Name="tbconvint" Style="{StaticResource Watermark}" Height="32" FontFamily="Consolas" FontSize="14" TextChanged="tbconvint_TextChanged"/>
                                                    <Button Grid.Column="1" Style="{StaticResource FormButton}" Height="32" Padding="10,0" Margin="4,0,0,0" Tag="{Binding ElementName=tbconvint}" Click="ConvCopy_Click" Content="{Binding Translation[conv_copy], FallbackValue=Copy}"/>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Translation[conv_uint], FallbackValue=Unsigned}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBox x:Name="tbconvuint" Style="{StaticResource Watermark}" Height="32" FontFamily="Consolas" FontSize="14" TextChanged="tbconvuint_TextChanged"/>
                                                    <Button Grid.Column="1" Style="{StaticResource FormButton}" Height="32" Padding="10,0" Margin="4,0,0,0" Tag="{Binding ElementName=tbconvuint}" Click="ConvCopy_Click" Content="{Binding Translation[conv_copy], FallbackValue=Copy}"/>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Translation[conv_hex], FallbackValue=Hexadecimal}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBox x:Name="tbconvhex" Style="{StaticResource Watermark}" Height="32" FontFamily="Consolas" FontSize="14" TextChanged="tbconvhex_TextChanged"/>
                                                    <Button Grid.Column="1" Style="{StaticResource FormButton}" Height="32" Padding="10,0" Margin="4,0,0,0" Tag="{Binding ElementName=tbconvhex}" Click="ConvCopy_Click" Content="{Binding Translation[conv_copy], FallbackValue=Copy}"/>
                                                </Grid>
                                            </StackPanel>
                                            </UniformGrid>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Translation[conv_bin], FallbackValue=Binary}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBox x:Name="tbconvbinary" Style="{StaticResource Watermark}" Height="32" FontFamily="Consolas" FontSize="14" TextChanged="tbconvbinary_TextChanged"/>
                                                    <Button Grid.Column="1" Style="{StaticResource FormButton}" Height="32" Padding="10,0" Margin="4,0,0,0" Tag="{Binding ElementName=tbconvbinary}" Click="ConvCopy_Click" Content="{Binding Translation[conv_copy], FallbackValue=Copy}"/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource DashCard}" Margin="0,0,0,12">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource DashCardHeader}">
                                            <TextBlock Style="{StaticResource DashCardTitle}" Text="{Binding Translation[conv_bits], FallbackValue=Bits}"/>
                                        </Border>
                                        <StackPanel Margin="14,12,14,10">
                                            <!-- Four bytes of eight tiles, filled in code: big Xenvious bit (1-32), small script bit (0-31). -->
                                            <UniformGrid x:Name="ConvBitsPanel" Columns="4"/>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource FaintTextBrush}" Margin="2,8,0,0" TextWrapping="Wrap" Text="{Binding Translation[conv_bits_hint], FallbackValue='Big: Xenvious bit (1-32), small: script bit (0-31). A click switches the bit.'}"/>
                                            <Label x:Name="Lblconvbinarynums" Padding="2,6,0,0" FontSize="13" Foreground="{DynamicResource TextColor}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource DashCard}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource DashCardHeader}">
                                            <TextBlock Style="{StaticResource DashCardTitle}" Text="{Binding Translation[conv_hit], FallbackValue=Recognised}"/>
                                        </Border>
                                        <Grid Margin="14,12,14,14">
                                            <TextBlock x:Name="ConvHitNone" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource NavMutedBrush}" Text="{Binding Translation[conv_nohit], FallbackValue='No model in our lists. The value is probably a bitset or another number.'}"/>
                                            <Grid x:Name="ConvHitPanel" Visibility="Collapsed">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="200" Height="140" CornerRadius="5" Background="{DynamicResource SeactionHeaderBackgroundBrush}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <Image x:Name="ConvHitImage" Stretch="Uniform"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock x:Name="ConvHitKind" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                                                    <TextBlock x:Name="ConvHitName" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,4" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="ConvHitNative" FontSize="13" FontFamily="Consolas" Foreground="{DynamicResource NavMutedBrush}"/>
                                                    <TextBlock x:Name="ConvHitCategory" FontSize="13" Foreground="{DynamicResource NavMutedBrush}" Margin="0,2,0,10"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button x:Name="Btncenvgetimg" Visibility="Collapsed" Style="{StaticResource FormButtonPrimary}" Height="32" Padding="12,0" Margin="0,0,8,0" Click="Btncenvgetimg_Click">
                                                            <TextBlock Foreground="{DynamicResource PrimaryButtonForeground}" Text="{Binding Translation[conv_showpic], FallbackValue='Show picture'}"/>
                                                        </Button>
                                                        <Button x:Name="BtnConvCatalog" Style="{StaticResource FormButton}" Height="32" Padding="12,0" Click="BtnConvCatalog_Click">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Translation[conv_catalog], FallbackValue='Open in catalog'}"/>
                                                                <Path Style="{StaticResource GoToPageIcon}"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                    <TextBlock x:Name="ConvHitSource" FontSize="12" Foreground="{DynamicResource FaintTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                    </TabItem>

                    <TabItem x:Name="PageTeleport" Header="Teleport">
                        <!-- Teleport to a position; the race part jumps to the next checkpoint. MainWindow.Teleport.cs. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="20,16,20,16" Width="640" HorizontalAlignment="Center">
                                <Border Style="{StaticResource DashCard}" Margin="0,0,0,12">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource DashCardHeader}">
                                            <TextBlock Style="{StaticResource DashCardTitle}" Text="{Binding Translation[teleport], FallbackValue=Teleport}"/>
                                        </Border>
                                        <StackPanel Margin="14,12,14,14">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Translation[tp_target], FallbackValue=Target}"/>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="30"/><ColumnDefinition Width="6"/><ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Style="{StaticResource FieldAxis}" Text="X"/>
                                                    <TextBox x:Name="tbteleportlocx" Style="{StaticResource Watermark}" Height="30" KeyDown="FormatTextForFloat"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Style="{StaticResource FieldAxis}" Text="Y"/>
                                                    <TextBox x:Name="tbteleportlocy" Style="{StaticResource Watermark}" Height="30" KeyDown="FormatTextForFloat"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Style="{StaticResource FieldAxis}" Text="Z"/>
                                                    <TextBox x:Name="tbteleportlocz" Style="{StaticResource Watermark}" Height="30" KeyDown="FormatTextForFloat"/>
                                                </StackPanel>
                                                <Button x:Name="Btnteleportgetlocation" Grid.Column="6" Style="{StaticResource FieldIconButton}" Width="30" Height="30" VerticalAlignment="Bottom" Click="Btnteleportgetlocation_Click" ToolTip="{Binding Translation[getcursorloc], FallbackValue='Get Cursor Location'}">
                                                    <Path Data="M8,1.5 L8,4.5 M8,11.5 L8,14.5 M1.5,8 L4.5,8 M11.5,8 L14.5,8 M8,5 A3,3 0 1 1 7.99,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="16" Height="16"/>
                                                </Button>
                                                <Button x:Name="Btnteleportgetplayerlocation" Grid.Column="8" Style="{StaticResource FieldIconButton}" Width="30" Height="30" VerticalAlignment="Bottom" Click="Btnteleportgetplayerlocation_Click" ToolTip="{Binding Translation[getplayerloc], FallbackValue='Get Player Location'}">
                                                    <Path Data="M8,2 A2.6,2.6 0 1 1 7.99,2 M3,15 C3,10 13,10 13,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="16" Height="16"/>
                                                </Button>
                                            </Grid>
                                            <Button x:Name="Btnteleportsetlocation" Style="{StaticResource FormButtonPrimary}" Height="34" Padding="18,0" HorizontalAlignment="Left" Click="Btnteleportsetlocation_Click">
                                                <TextBlock Foreground="{DynamicResource PrimaryButtonForeground}" Text="{Binding Translation[teleport], FallbackValue=Teleport}"/>
                                            </Button>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource FaintTextBrush}" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding Translation[tp_hint], FallbackValue='Fill the target from the cursor or your own position, or type it in.'}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource DashCard}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource DashCardHeader}">
                                            <TextBlock Style="{StaticResource DashCardTitle}" Text="{Binding Translation[race], FallbackValue=Race}"/>
                                        </Border>
                                        <WrapPanel Margin="14,12,8,8">
                                            <Button x:Name="Btnteleportgetnextcplocation" Style="{StaticResource FormButton}" Height="32" Padding="12,0" Margin="0,0,6,6" Click="Btnteleportgetnextcplocation_Click" Content="{Binding Translation[getnextcploc], FallbackValue=Get Next Checkpoint Location}"/>
                                            <Button x:Name="Btnteleportnextcplocation" Style="{StaticResource FormButton}" Height="32" Padding="12,0" Margin="0,0,6,6" Click="Btnteleportnextcplocation_Click" Content="{Binding Translation[teleportnextcploc], FallbackValue=Teleport to Next Checkpoint Location}"/>
                                        </WrapPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="PageGEditor" Header="Global Editor">
                        <!-- Read and write one global or script local, and the freeze lists. MainWindow.GlobalLocalEditor.cs. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="20,16,20,16" Width="900" HorizontalAlignment="Center">
                            <UniformGrid Columns="2">
                                <Border Margin="0,0,6,0" Style="{StaticResource DashCard}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource DashCardHeader}">
                                            <TextBlock Style="{StaticResource DashCardTitle}" Text="{Binding Translation[ge_global], FallbackValue='Global'}"/>
                                        </Border>
                                        <StackPanel Margin="14,12,14,8">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Translation[ge_index], FallbackValue='Global (Global_N.f_M or number)'}"/>
                                            <TextBox x:Name="tbgeglobal" Style="{StaticResource Watermark}" Height="30" Margin="0,0,0,10"/>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Translation[ge_value], FallbackValue='Value'}"/>
                                            <TextBox x:Name="tbgeglobalvalue" Style="{StaticResource Watermark}" Height="30" Margin="0,0,0,10"/>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Translation[ge_type], FallbackValue=Type}"/>
                                            <ComboBox x:Name="ddgechangemode" FontFamily="{DynamicResource Volte}" Height="30" Margin="0,0,0,12">
                                                <ComboBoxItem Content="Byte"/>
                                                <ComboBoxItem Content="Short"/>
                                                <ComboBoxItem Content="Integer" Selector.IsSelected="True"/>
                                                <ComboBoxItem Content="Long"/>
                                                <ComboBoxItem Content="Float"/>
                                                <ComboBoxItem Content="Double"/>
                                                <ComboBoxItem Content="String"/>
                                            </ComboBox>
                                            <WrapPanel>
                                                <Button x:Name="Btngereadglobal" Style="{StaticResource FormButton}" Height="32" Padding="12,0" Margin="0,0,6,6" Click="Btngereadglobal_Click" Content="{Binding Translation[ge_read], FallbackValue='Read'}"/>
                                                <Button x:Name="Btngewriteglobal" Style="{StaticResource FormButtonPrimary}" Height="32" Padding="12,0" Margin="0,0,6,6" Click="Btngewriteglobal_Click" Content="{Binding Translation[ge_write], FallbackValue='Write'}"/>
                                                <Button x:Name="Btngecopyaddy" Style="{StaticResource FormButton}" Height="32" Padding="12,0" Margin="0,0,6,6" Click="Btngecopyaddy_Click" Content="{Binding Translation[ge_copy], FallbackValue='Copy address'}"/>
                                                <Button x:Name="Btngeadd2f" Style="{StaticResource FormButton}" Height="32" Padding="12,0" Margin="0,0,6,6" Click="Btngeadd2f_Click" Content="{Binding Translation[ge_add2f], FallbackValue='Add to freeze list'}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Margin="6,0,0,0" Style="{StaticResource DashCard}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource DashCardHeader}">
                                            <TextBlock Style="{StaticResource DashCardTitle}" Text="{Binding Translation[ge_local], FallbackValue='Local'}"/>
                                        </Border>
                                        <StackPanel Margin="14,12,14,8">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Translation[ge_script], FallbackValue='Script'}"/>
                                            <TextBox x:Name="tblelocalscript" Style="{StaticResource Watermark}" Height="30" Margin="0,0,0,10" Text="fm_capture_creator"/>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Translation[ge_localidx], FallbackValue='Local'}"/>
                                            <TextBox x:Name="tblelocal" Style="{StaticResource Watermark}" Height="30" Margin="0,0,0,10"/>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Translation[ge_value], FallbackValue='Value'}"/>
                                            <TextBox x:Name="tblelocalvalue" Style="{StaticResource Watermark}" Height="30" Margin="0,0,0,10"/>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Translation[ge_type], FallbackValue=Type}"/>
                                            <ComboBox x:Name="ddlechangemode" FontFamily="{DynamicResource Volte}" Height="30" Margin="0,0,0,12" SelectionChanged="ddlechangemode_SelectionChanged">
                                                <ComboBoxItem Content="Byte"/>
                                                <ComboBoxItem Content="Short"/>
                                                <ComboBoxItem Content="Integer" Selector.IsSelected="True"/>
                                                <ComboBoxItem Content="Long"/>
                                                <ComboBoxItem Content="Float"/>
                                                <ComboBoxItem Content="Double"/>
                                                <ComboBoxItem Content="String"/>
                                            </ComboBox>
                                            <WrapPanel>
                                                <Button x:Name="Btnlereadglobal" Style="{StaticResource FormButton}" Height="32" Padding="12,0" Margin="0,0,6,6" Click="Btnlereadglobal_Click" Content="{Binding Translation[ge_read], FallbackValue='Read'}"/>
                                                <Button x:Name="Btnlewriteglobal" Style="{StaticResource FormButtonPrimary}" Height="32" Padding="12,0" Margin="0,0,6,6" Click="Btnlewriteglobal_Click" Content="{Binding Translation[ge_write], FallbackValue='Write'}"/>
                                                <Button x:Name="Btnlecopyaddy" Style="{StaticResource FormButton}" Height="32" Padding="12,0" Margin="0,0,6,6" Click="Btnlecopyaddy_Click" Content="{Binding Translation[ge_copy], FallbackValue='Copy address'}"/>
                                                <Button x:Name="Btnleadd2f" Style="{StaticResource FormButton}" Height="32" Padding="12,0" Margin="0,0,6,6" Click="Btnleadd2f_Click" Content="{Binding Translation[ge_add2f], FallbackValue='Add to freeze list'}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </UniformGrid>
                                    <!-- Global and local freeze list share one card; the header switches between them. -->
                                    <Border Style="{StaticResource DashCard}" Margin="0,12,0,0">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Style="{StaticResource DashCardHeader}">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button x:Name="BtnFreezeListGlobal" Style="{StaticResource FormButtonPrimary}" Content="Global" Height="28" Padding="12,0" Margin="0,0,6,0" Click="BtnFreezeListGlobal_Click"/>
                                                        <Button x:Name="BtnFreezeListLocal" Style="{StaticResource FormButton}" Content="Local" Height="28" Padding="12,0" Click="BtnFreezeListLocal_Click"/>
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource DashCardTitle}" Text="{Binding Translation[ge_freeze], FallbackValue='Freeze list'}"/>
                                                </DockPanel>
                                            </Border>

                                            <Grid x:Name="gridFreezeGlobal" Grid.Row="1" Margin="14,12,14,12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="50"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" >
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="0.41*"/>
                                                        <ColumnDefinition Width="0.41*"/>
                                                        <ColumnDefinition Width="0.16*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource FaintTextBrush}" TextTrimming="CharacterEllipsis" Text="Name" />
                                                    <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource FaintTextBrush}" TextTrimming="CharacterEllipsis" Text="Value" />
                                                    <TextBlock Grid.Column="2" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource FaintTextBrush}" TextTrimming="CharacterEllipsis" Text="Freeze" HorizontalAlignment="Right" />
                                                </Grid>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1" VerticalContentAlignment="Stretch">
                                                    <Grid VerticalAlignment="Stretch" Height="300">
                                                        <ListBox x:Name="freezeList"  ItemsSource="{Binding .}" IsEnabled="true" Background="{DynamicResource SectionBackgroundBrush}" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"  Height="{Binding RelativeSource={RelativeSource Self},Path=Parent.ActualHeight}" MouseDoubleClick="freezeList_MouseDoubleClick">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid x:Name="Grid" ToolTip="{Binding GlobalName}">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="0.41*"/>
                                                                            <ColumnDefinition Width="0.41*"/>
                                                                            <ColumnDefinition Width="0.08*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" FontSize="14" Foreground="{DynamicResource TextColor}" TextTrimming="CharacterEllipsis" Text="{Binding Name}" VerticalAlignment="Center" />
                                                                        <TextBox x:Name="tbgevalue" Style="{StaticResource Watermark}"  Grid.Column="1" FontSize="14" Foreground="{DynamicResource TextColor}" Text="{Binding val, Converter={StaticResource FreezeValueConverter}}">
                                                                            <i:Interaction.Triggers>
                                                                                <i:EventTrigger EventName="TextChanged">
                                                                                    <i:InvokeCommandAction Command="{Binding DataContext.ChangeValue, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}"
                                                                                                           CommandParameter="{Binding ElementName=tbgevalue,Path=Text}">
                                                                                    </i:InvokeCommandAction>
                                                                                </i:EventTrigger>
                                                                            </i:Interaction.Triggers>
                                                                        </TextBox>
                                                                        <CheckBox x:Name="cbgefreeze" Grid.Column="2" MaxHeight="40">
                                                                            <i:Interaction.Triggers>
                                                                                <i:EventTrigger EventName="Checked">
                                                                                    <i:InvokeCommandAction Command="{Binding DataContext.CheckedChanged, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}" >
                                                                                    </i:InvokeCommandAction>
                                                                                </i:EventTrigger>
                                                                                <i:EventTrigger EventName="Unchecked">
                                                                                    <i:InvokeCommandAction Command="{Binding DataContext.CheckedChanged, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}" >
                                                                                    </i:InvokeCommandAction>
                                                                                </i:EventTrigger>
                                                                            </i:Interaction.Triggers>
                                                                        </CheckBox>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                            <ListBox.ItemContainerStyle>
                                                                <Style TargetType="{x:Type ListBoxItem}">
                                                                    <Setter Property="FontSize" Value="14"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                                <Border Name="_Border" Padding="2" SnapsToDevicePixels="true">
                                                                                    <ContentPresenter />
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsSelected" Value="true">
                                                                                        <Setter TargetName="_Border" Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
                                                                                    </Trigger>
                                                                                    <Trigger Property="IsEnabled" Value="false">
                                                                                        <Setter Property="Foreground" Value="#888"/>
                                                                                    </Trigger>
                                                                                    <MultiTrigger>
                                                                                        <MultiTrigger.Conditions>
                                                                                            <Condition Property="IsMouseOver" Value="true"/>
                                                                                            <Condition Property="IsSelected" Value="false"/>
                                                                                        </MultiTrigger.Conditions>
                                                                                        <MultiTrigger.Setters>
                                                                                            <Setter TargetName="_Border" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                                                        </MultiTrigger.Setters>
                                                                                    </MultiTrigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </ListBox.ItemContainerStyle>
                                                        </ListBox>
                                                    </Grid>
                                                </ScrollViewer>
                                                <Button Grid.Row="2" x:Name="Btngefreezelistdel" Style="{StaticResource FormButton}" Content="{Binding Translation[delete], FallbackValue=Delete}" Height="32" Padding="14,0" Margin="0,10,0,0" HorizontalAlignment="Left" Click="Btngefreezelistdel_Click"/>
                                            </Grid>
                                            <Grid x:Name="gridFreezeLocal" Grid.Row="1" Margin="14,12,14,12" Visibility="Collapsed">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="50"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" >
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="0.61*"/>
                                                        <ColumnDefinition Width="0.41*"/>
                                                        <ColumnDefinition Width="0.20*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource FaintTextBrush}" TextTrimming="CharacterEllipsis" Text="Name/Script" />
                                                    <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource FaintTextBrush}" TextTrimming="CharacterEllipsis" Text="Value" />
                                                    <TextBlock Grid.Column="2" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource FaintTextBrush}" TextTrimming="CharacterEllipsis" Text="Freeze" HorizontalAlignment="Right" />
                                                </Grid>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1" VerticalContentAlignment="Stretch">
                                                    <Grid VerticalAlignment="Stretch" Height="300">
                                                        <ListBox x:Name="localfreezeList"  ItemsSource="{Binding .}" IsEnabled="true" Background="{DynamicResource SectionBackgroundBrush}" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"  Height="{Binding RelativeSource={RelativeSource Self},Path=Parent.ActualHeight}" MouseDoubleClick="localfreezeList_MouseDoubleClick">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid x:Name="Grid">
                                                                        <Grid.ToolTip>
                                                                            <Grid MaxWidth="500" MaxHeight="200">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="0.5*"/>
                                                                                    <ColumnDefinition Width="0.5*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="20"/>
                                                                                    <RowDefinition Height="20"/>
                                                                                    <RowDefinition Height="20"/>
                                                                                    <RowDefinition Height="20"/>
                                                                                    <RowDefinition Height="20"/>
                                                                                </Grid.RowDefinitions>

                                                                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" Text="Name"/>
                                                                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" Text="Scriptname"/>
                                                                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" Text="Local value"/>
                                                                                <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" Text="Calculated local value"/>
                                                                                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" Text="Value to write"/>

                                                                                <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" Text="{Binding Path=Name}" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" Text="{Binding Path=Script}" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" Text="{Binding Path=LocalName}" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" Text="{Binding Path=LocalValue}" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" Text="{Binding Path=val, Converter={StaticResource FreezeValueConverter}}" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>


                                                                            </Grid>
                                                                            <!--<TextBlock>
                                                                                <MultiBinding StringFormat="{}Name: {0}&#x0d;&#x0a;Scriptname: {1}&#x0d;&#x0a;Value: {2}">
                                                                                    <Binding Path="Name" />
                                                                                    <Binding Path="Script" />
                                                                                    <Binding Path="val" Converter="{StaticResource FreezeValueConverter}" />
                                                                                </MultiBinding>
                                                                                <Run Text="{Binding Name, Mode=OneTime}" />
                                                                                <LineBreak/>
                                                                                <Run Text="{Binding Exception, Mode=OneTime, TargetNullValue='', StringFormat={}&#x0d;&#x0a;{0}}"  />
                                                                            </TextBlock>-->
                                                                        </Grid.ToolTip>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="0.41*"/>
                                                                            <ColumnDefinition Width="0.41*"/>
                                                                            <ColumnDefinition Width="0.08*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" FontSize="14" Foreground="{DynamicResource TextColor}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                                            <TextBlock.Text>
                                                                                <MultiBinding StringFormat="{}{0}/{1}">
                                                                                    <Binding Path="Name" />
                                                                                    <Binding Path="Script" />
                                                                                </MultiBinding>
                                                                            </TextBlock.Text>
                                                                        </TextBlock>
                                                                        <TextBox x:Name="tblevalue" Style="{StaticResource Watermark}"  Grid.Column="1" FontSize="14" Foreground="{DynamicResource TextColor}" Text="{Binding val, Converter={StaticResource FreezeValueConverter}}">
                                                                            <i:Interaction.Triggers>
                                                                                <i:EventTrigger EventName="TextChanged">
                                                                                    <i:InvokeCommandAction Command="{Binding DataContext.ChangeValue, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}"
                                                                                                           CommandParameter="{Binding ElementName=tblevalue,Path=Text}">
                                                                                    </i:InvokeCommandAction>
                                                                                </i:EventTrigger>
                                                                            </i:Interaction.Triggers>
                                                                        </TextBox>
                                                                        <CheckBox x:Name="cblefreeze" Grid.Column="2" MaxHeight="40">
                                                                            <i:Interaction.Triggers>
                                                                                <i:EventTrigger EventName="Checked">
                                                                                    <i:InvokeCommandAction Command="{Binding DataContext.CheckedChanged, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}" >
                                                                                    </i:InvokeCommandAction>
                                                                                </i:EventTrigger>
                                                                                <i:EventTrigger EventName="Unchecked">
                                                                                    <i:InvokeCommandAction Command="{Binding DataContext.CheckedChanged, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}" >
                                                                                    </i:InvokeCommandAction>
                                                                                </i:EventTrigger>
                                                                            </i:Interaction.Triggers>
                                                                        </CheckBox>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                            <ListBox.ItemContainerStyle>
                                                                <Style TargetType="{x:Type ListBoxItem}">
                                                                    <Setter Property="FontSize" Value="14"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                                <Border Name="_Border" Padding="2" SnapsToDevicePixels="true">
                                                                                    <ContentPresenter />
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsSelected" Value="true">
                                                                                        <Setter TargetName="_Border" Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
                                                                                    </Trigger>
                                                                                    <Trigger Property="IsEnabled" Value="false">
                                                                                        <Setter Property="Foreground" Value="#888"/>
                                                                                    </Trigger>
                                                                                    <MultiTrigger>
                                                                                        <MultiTrigger.Conditions>
                                                                                            <Condition Property="IsMouseOver" Value="true"/>
                                                                                            <Condition Property="IsSelected" Value="false"/>
                                                                                        </MultiTrigger.Conditions>
                                                                                        <MultiTrigger.Setters>
                                                                                            <Setter TargetName="_Border" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                                                        </MultiTrigger.Setters>
                                                                                    </MultiTrigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </ListBox.ItemContainerStyle>
                                                        </ListBox>
                                                    </Grid>
                                                </ScrollViewer>
                                                <Button Grid.Row="2" x:Name="Btnlefreezelistdel" Style="{StaticResource FormButton}" Content="{Binding Translation[delete], FallbackValue=Delete}" Height="32" Padding="14,0" Margin="0,10,0,0" HorizontalAlignment="Left" Click="Btnlefreezelistdel_Click"/>
                                            </Grid>
                                        </Grid>
                                    </Border>



                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>


                </TabControl>

                <Grid Background="{DynamicResource BackgroundBrush}" Visibility="Collapsed" x:Name="SGTAMessage" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.2*"/>
                        <ColumnDefinition Width="0.6*"/>
                        <ColumnDefinition Width="0.2*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.2*"/>
                        <RowDefinition Height="0.6*"/>
                        <RowDefinition Height="0.2*"/>
                    </Grid.RowDefinitions>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="Grid.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation From="0" To="5" Duration="00:00:03" Storyboard.TargetName="blurEffectSGTA" Storyboard.TargetProperty="Radius"></DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                    <Border Opacity="0.1" Grid.RowSpan="3" Grid.ColumnSpan="3">
                        <Border.Effect>
                            <BlurEffect Radius="5" x:Name="blurEffectSGTA"/>
                        </Border.Effect>
                        <Border.Background>
                            <VisualBrush  Visual="{Binding ElementName=MainPages}" Stretch="None" />
                        </Border.Background>
                    </Border>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1" Grid.Column="1" x:Name="SGTAMessageContainer" >
                        <Label x:Name="Lbl_SGTA" Foreground="{DynamicResource BadBrush}" FontFamily="{DynamicResource Volte}" FontWeight="Bold" FontSize="24" Content="{Binding Translation[start_gta_needed], FallbackValue=You need to start GTA 5 to use this Tool.}" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{x:Null}" />
                    </Grid>
                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20">
                        <Border CornerRadius="5" Background="{DynamicResource SectionBackgroundBrush}" Margin="4" VerticalAlignment="Center" MaxHeight="34">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="{DynamicResource ShadowColor}"/>
                            </Border.Effect>
                            <Button x:Name="BtnDismissSGTALaunch" FontSize="16" Style="{DynamicResource CustomButton}" local:CornerRadiusSetter.CornerRadius="5" Click="BtnDismissSGTALaunch_Click" Content="{Binding Translation[hidegtamessagelaunch], FallbackValue=Hide for this launch}" Foreground="{DynamicResource TextColor}" />
                        </Border>
                        <Border CornerRadius="5" Background="{DynamicResource SectionBackgroundBrush}" Margin="4" VerticalAlignment="Center" MaxHeight="34">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="{DynamicResource ShadowColor}"/>
                            </Border.Effect>
                            <Button x:Name="BtnDismissSGTAAlways" FontSize="16" Style="{DynamicResource CustomButton}" local:CornerRadiusSetter.CornerRadius="5" Click="BtnDismissSGTAAlways_Click" Content="{Binding Translation[hidegtamessagealways], FallbackValue=Hide always}" Foreground="{DynamicResource TextColor}" />
                        </Border>
                    </StackPanel>
                </Grid>

            </Grid>

            <Grid Background="{DynamicResource BackgroundBrush}" Visibility="Collapsed" x:Name="ScreenMessage" Grid.Row="0" Grid.RowSpan="2" MouseLeftButtonUp="IMGBackground_MouseLeftButtonUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.2*"/>
                    <ColumnDefinition Width="0.6*"/>
                    <ColumnDefinition Width="0.2*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.6*"/>
                    <RowDefinition Height="0.2*"/>
                </Grid.RowDefinitions>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Grid.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation From="0" To="5" Duration="00:00:03" Storyboard.TargetName="blurEffect" Storyboard.TargetProperty="Radius"></DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
                <Border Opacity="0.1" Grid.RowSpan="3" Grid.ColumnSpan="3">
                    <Border.Effect>
                        <BlurEffect Radius="5" x:Name="blurEffect"/>
                    </Border.Effect>
                    <Border.Background>
                        <VisualBrush  Visual="{Binding ElementName=Main}" Stretch="None" />
                    </Border.Background>
                </Border>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1" Grid.Column="1" x:Name="ScreenMessageContainer" >
                    
                </Grid>
            </Grid>

            <!-- In-app dialog (MainWindow.Dialog.cs): dims and blurs the window behind a card. -->
            <local:ModelCatalog x:Name="ModelCatalogOverlay" Grid.Row="0" Grid.RowSpan="2"/>

            <Grid x:Name="DialogOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Background="#99000000" Focusable="True" KeyDown="DialogOverlay_KeyDown">
                <Border CornerRadius="8" Background="{DynamicResource SeactionHeaderBackgroundBrush}" Padding="26,22" MinWidth="380" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.75" Color="{DynamicResource ShadowColor}"/></Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="DialogTitle" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextColor}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DialogText" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <!-- Longer text such as release notes; scrolls instead of growing the dialog. -->
                        <ScrollViewer x:Name="DialogDetailsScroll" MaxHeight="320" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <TextBlock x:Name="DialogDetails" FontSize="13" Foreground="{DynamicResource TextColor}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                        </ScrollViewer>
                        <ProgressBar x:Name="DialogProgress" Height="6" Margin="0,18,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" Foreground="{DynamicResource HighlightBrush}" Background="#33FFFFFF" BorderThickness="0"/>
                        <StackPanel x:Name="DialogButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Border x:Name="DialogCancelContainer" CornerRadius="5" Background="{DynamicResource SectionBackgroundBrush}" Height="34" MinWidth="110" Margin="0,0,10,0">
                                <Button x:Name="DialogCancel" Style="{DynamicResource CustomButton}" local:CornerRadiusSetter.CornerRadius="5" FontSize="14" Foreground="{DynamicResource TextColor}" Padding="14,0" Click="DialogCancel_Click"/>
                            </Border>
                            <Border x:Name="DialogAltContainer" Visibility="Collapsed" CornerRadius="5" Background="{DynamicResource SectionBackgroundBrush}" Height="34" MinWidth="110" Margin="0,0,10,0">
                                <Button x:Name="DialogAlt" Style="{DynamicResource CustomButton}" local:CornerRadiusSetter.CornerRadius="5" FontSize="14" Foreground="{DynamicResource TextColor}" Padding="14,0" Click="DialogAlt_Click"/>
                            </Border>
                            <Border x:Name="DialogConfirmContainer" CornerRadius="5" Background="{DynamicResource HighlightBrush}" Height="34" MinWidth="130">
                                <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.5" Color="{DynamicResource ShadowColor}"/></Border.Effect>
                                <Button x:Name="DialogConfirm" Cursor="Hand" FontSize="14" FontWeight="Bold" Padding="16,0" Click="DialogConfirm_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="Transparent" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#22FFFFFF"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
