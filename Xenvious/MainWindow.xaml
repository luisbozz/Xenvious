<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Xenvious"
        xmlns:Controls="clr-namespace:Xenvious.Controls"
        xmlns:logging="clr-namespace:Xenvious.Logging"
        xmlns:li="clr-namespace:LoadingIndicators.WPF;assembly=LoadingIndicators.WPF"
        xmlns:System="clr-namespace:System;assembly=mscorlib" xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        x:Class="Xenvious.MainWindow"
        mc:Ignorable="d"
        Title="Xenvious" Height="933" Width="1532" WindowStyle="None" FontFamily="{DynamicResource Volte}" FontSize="14" MinHeight="575" MinWidth="825" Loaded="Window_Loaded" Background="{DynamicResource BackgroundBrush}" Closed="Window_Closed" PreviewMouseWheel="Window_PreviewMouseWheel">


    <Window.Resources>
        <ResourceDictionary>
            <local:ColorToShadowColorConverter x:Key="ColorConverter"/>
            <local:IsCheckedConverter x:Key="IsCheckedConverter"/>
            <local:FreezeValueConverter x:Key="FreezeValueConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>


            <Style TargetType="{x:Type ScrollViewer}">
                <EventSetter Event="MouseWheel" Handler="UIElement_OnMouseWheel"/>
            </Style>

            <Style TargetType="{x:Type Label}">
                <Setter Property="FontFamily" Value="{DynamicResource Volte}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="{x:Type Button}">
                <Setter Property="FontFamily" Value="{DynamicResource Volte}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="{x:Type TextBox}">
                <Setter Property="FontFamily" Value="{DynamicResource Volte}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            </Style>

            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{DynamicResource Volte}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="Gray"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- One shared row shape for label+checkbox lines, so every entry lines up.
                 The app's CheckBox template has no ContentPresenter, so a checkbox
                 never shows its own Content - the label is always a separate TextBlock. -->
            <Style x:Key="FormRow" TargetType="{x:Type Grid}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
            </Style>
            <Style x:Key="FormLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Grid.Column" Value="0"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="FormToggle" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>
            <!-- Cards of the dashboard and the settings: a panel with a header bar. -->
            <Style x:Key="DashCard" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource SectionBackgroundBrush}"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>
            <Style x:Key="DashCardHeader" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource SeactionHeaderBackgroundBrush}"/>
                <Setter Property="CornerRadius" Value="5,5,0,0"/>
                <Setter Property="Padding" Value="14,9"/>
            </Style>
            <Style x:Key="DashCardTitle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <!-- Inside cards: the label above a field, the X/Y/Z over a vector box, the name of a raw value, a small heading. -->
            <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Foreground" Value="{DynamicResource NavMutedBrush}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="FieldAxis" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}"/>
                <Setter Property="Margin" Value="2,0,0,3"/>
            </Style>
            <Style x:Key="FieldLabelRaw" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
            <Style x:Key="CardSub" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
            <!-- A card that starts folded (raw values): the header bar is the toggle. -->
            <Style x:Key="CardExpander" TargetType="{x:Type Expander}">
                <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Expander}">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Top" Content="{TemplateBinding Header}" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border x:Name="b" Background="{DynamicResource SeactionHeaderBackgroundBrush}" CornerRadius="5" Padding="14,9">
                                                <DockPanel>
                                                    <Path x:Name="chev" DockPanel.Dock="Right" Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource NavMutedBrush}" StrokeThickness="1.8"
                                                          VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="-90"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                    <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="17" TextElement.FontWeight="Bold"
                                                                      TextElement.Foreground="{DynamicResource TextColor}"/>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="chev" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter TargetName="b" Property="CornerRadius" Value="5,5,0,0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="body" Visibility="Collapsed"/>
                            </DockPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="body" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Loading dots. Replaces LoadingIndicators.WPF for the prop panels: that style
                 colours through its own AccentColorBrush and ignores Foreground, and its
                 IsActive was bound to a property that does not exist, so it never showed. -->
            <ControlTemplate x:Key="DotsLoader" TargetType="{x:Type Control}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Ellipse}">
                            <Setter Property="Width" Value="12"/>
                            <Setter Property="Height" Value="12"/>
                            <Setter Property="Margin" Value="5,0"/>
                            <Setter Property="Fill" Value="{DynamicResource DisabledForegroundBrush}"/>
                            <Setter Property="Opacity" Value="0.25"/>
                        </Style>
                    </StackPanel.Resources>
                    <Ellipse x:Name="d1"/>
                    <Ellipse x:Name="d2"/>
                    <Ellipse x:Name="d3"/>
                </StackPanel>
                <ControlTemplate.Triggers>
                    <!-- IsVisible, not Loaded: the control starts collapsed, so its template is
                         applied only when it is shown, after Loaded has already fired. -->
                    <Trigger Property="IsVisible" Value="True">
                        <Trigger.EnterActions>
                        <BeginStoryboard x:Name="dotsRun">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="d1" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.35" AutoReverse="True" BeginTime="0:0:0"/>
                                <DoubleAnimation Storyboard.TargetName="d2" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.35" AutoReverse="True" BeginTime="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetName="d3" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.35" AutoReverse="True" BeginTime="0:0:0.4"/>
                            </Storyboard>
                        </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="dotsRun"/>
                        </Trigger.ExitActions>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
            <Style x:Key="SettingsLink" TargetType="{x:Type Hyperlink}">
                <Setter Property="FontFamily" Value="{DynamicResource Volte}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                <Setter Property="TextDecorations" Value="{x:Null}"/>
            </Style>
            <Style x:Key="SettingsLinkRow" TargetType="{x:Type TextBlock}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
                <Setter Property="Padding" Value="0,8,0,0"/>
            </Style>
            <!-- Deliberately NOT BasedOn the default TextBlock style: its FontSize and
                 Foreground setters would beat what this TextBlock inherits from the
                 Hyperlink around it, and the links would come out white and small. -->
            <Style x:Key="SettingsLinkText" TargetType="{x:Type TextBlock}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="TextDecorations" Value="Underline"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="{x:Type ListView}" TargetType="ListView">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListView">
                            <Border Name="Border">
                                <Border.Background>
                                    <SolidColorBrush Color="Transparent" />
                                </Border.Background>
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="Border" Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="Transparent" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="true">
                                    <Setter TargetName="Border" Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="Transparent" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>


    <WindowChrome.WindowChrome>
        <WindowChrome     
            GlassFrameThickness="-1" 
            ResizeBorderThickness="5"
            CaptionHeight="0"
            UseAeroCaptionButtons="True"/>
    </WindowChrome.WindowChrome>

    <Border BorderThickness="0">
        <Border.Style>
            <Style TargetType="{x:Type Border}">
                <Style.Triggers>
                    <!-- Add to avoid border disappearing when window is maximised -->
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" 
                                 Value="Maximized">
                        <Setter Property="Margin" Value="5"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" 
                                 Value="Normal">
                        <Setter Property="Margin" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid x:Name="MainGrid">

            <Grid x:Name="Main">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <Grid Grid.Row="0" Background="{DynamicResource SectionBackgroundBrush}" MouseDown="Grid_MouseDown" Height="50" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto" MaxWidth="200"/>
                        <ColumnDefinition Width="auto" MaxWidth="200"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4"/>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="XenviousImage" Source="{StaticResource ogimage256}"  Margin="10 0" MouseDown="XenviousImage_MouseDown"/>
                        <Rectangle Grid.Column="1" HorizontalAlignment="center" VerticalAlignment="Stretch" Fill="DimGray" Width="1" Margin="0 6"/>
                    </Grid>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" Grid.Column="1" x:Name="panelTopSwitcher" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">

                            <!-- Pages that work on the open job -->
                            <Border Style="{StaticResource NavGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="Btndashboard" Style="{StaticResource NavButton}" Click="Btndashboard_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Style="{StaticResource NavIconBox}"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavIcon}" Data="{StaticResource NavIconDashboard}"/></Canvas></Viewbox>
                                            <TextBlock Text="{Binding Translation[dashboard], FallbackValue=Dashboard}" Style="{StaticResource NavLabel}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnEdit" Style="{StaticResource NavButton}" Click="BtnEdit_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Style="{StaticResource NavIconBox}"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavIcon}" Data="{StaticResource NavIconEdit}"/></Canvas></Viewbox>
                                            <TextBlock Text="{Binding Translation[edit], FallbackValue=Edit}" Style="{StaticResource NavLabel}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnCopyJobs" Style="{StaticResource NavButton}" Click="BtnCopyJobs_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Style="{StaticResource NavIconBox}"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavIcon}" Data="{StaticResource NavIconCopy}"/></Canvas></Viewbox>
                                            <TextBlock Text="{Binding Translation[copyjobs], FallbackValue=Copy Jobs}" Style="{StaticResource NavLabel}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Tools -->
                            <Border Style="{StaticResource NavGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnConverter" Style="{StaticResource NavButton}" Click="BtnConverter_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Style="{StaticResource NavIconBox}"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavIcon}" Data="{StaticResource NavIconConvert}"/></Canvas></Viewbox>
                                            <TextBlock Text="{Binding Translation[converter], FallbackValue=Converter}" Style="{StaticResource NavLabel}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnTeleport" Style="{StaticResource NavButton}" Click="BtnTeleport_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Style="{StaticResource NavIconBox}"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavIcon}" Data="{StaticResource NavIconTeleport}"/></Canvas></Viewbox>
                                            <TextBlock Text="{Binding Translation[teleport], FallbackValue=Teleport}" Style="{StaticResource NavLabel}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnGEditor" Style="{StaticResource NavButton}" Click="BtnGEditor_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Style="{StaticResource NavIconBox}"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavIcon}" Data="{StaticResource NavIconEditor}"/></Canvas></Viewbox>
                                            <TextBlock Text="{Binding Translation[geditor], FallbackValue='Global/Local Editor'}" Style="{StaticResource NavLabel}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnMod" Style="{StaticResource NavButton}" Click="BtnMod_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Style="{StaticResource NavIconBox}"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavIcon}" Data="{StaticResource NavIconMisc}"/></Canvas></Viewbox>
                                            <TextBlock Text="Misc" Style="{StaticResource NavLabel}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnSettings" Style="{StaticResource NavButton}" Click="BtnSettings_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Style="{StaticResource NavIconBox}"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavIcon}" Data="{StaticResource NavIconSettings}"/></Canvas></Viewbox>
                                            <TextBlock Text="{Binding Translation[settings], FallbackValue=Settings}" Style="{StaticResource NavLabel}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>


                    <Grid Grid.Column="2" Visibility="{Binding ElementName=BtnOnlineEnabler, Path=Visibility}" Width="200">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="5" Background="{DynamicResource SectionBackgroundBrush}" Margin="4" VerticalAlignment="Center" MaxHeight="30">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="{DynamicResource ShadowColor}"/>
                            </Border.Effect>
                            <Button x:Name="BtnOnlineEnabler" FontSize="16" Style="{DynamicResource CustomButton}" local:CornerRadiusSetter.CornerRadius="5" Click="BtnOnlineEnabler_Click" Content="{Binding Translation[onlineenable], FallbackValue=Enable Online}" Foreground="{DynamicResource TextColor}" />
                        </Border>
                        <Rectangle Grid.Column="1" HorizontalAlignment="center" VerticalAlignment="Stretch" Fill="DimGray" Width="1" Margin="15 6 10 6"/>
                    </Grid>

                    <Grid Grid.Column="3" Visibility="{Binding ElementName=BtnLaunchCreator, Path=Visibility}" Width="200">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Main action of the title bar, same look as "+ Add". -->
                        <Button x:Name="BtnLaunchCreator" Style="{StaticResource FormButtonPrimary}" Height="30" FontSize="14" Margin="4" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnLaunchCreator_Click" Content="{Binding Translation[launchcreator], FallbackValue=Launch Creator}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Rectangle Grid.Column="1" HorizontalAlignment="center" VerticalAlignment="Stretch" Fill="DimGray" Width="1" Margin="15 6 10 6" />
                    </Grid>


                    <Button x:Name="BtnMinimize" Grid.Column="4" Style="{DynamicResource TitleBarButton}" Click="BtnMinimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" >
                        <Path x:Name="minimizepath"  Data="M 0 0 L 6 6 L 12 0 Z" Stretch="Uniform" Stroke="{DynamicResource TextColor}" Margin="7"/>
                    </Button>

                    <Button x:Name="BtnClose" Grid.Column="5" Style="{DynamicResource TitleBarButton}" Click="BtnClose_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path x:Name="closepath" Data="M0,0 L1,1 M0,1 L1,0" Stretch="Uniform" Stroke="{DynamicResource TextColor}" Margin="7"/>
                    </Button>


                </Grid>

                <TabControl x:Name="MainPages" Grid.Row="1" BorderThickness="0" Margin="5" Background="Transparent" Focusable="False" SelectionChanged="MainPages_SelectionChanged">
                    <!--<TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Setter Property="Header" Value="{Binding Title}"/>
                        </Style>
                    </TabControl.ItemContainerStyle>-->

                    <TabItem x:Name="PageDashboard" Header="Dashboard" >

                        <Grid>
                            <Grid.Resources>
                                <!-- Dashboard look: tiles in the status bar, cards below. -->
                                <Style x:Key="DashBar" TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="{DynamicResource SectionBackgroundBrush}"/>
                                    <Setter Property="CornerRadius" Value="5"/>
                                    <Setter Property="Padding" Value="8,8,8,0"/>
                                </Style>
                                <Style x:Key="DashTile" TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="{DynamicResource SeactionHeaderBackgroundBrush}"/>
                                    <Setter Property="CornerRadius" Value="5"/>
                                    <Setter Property="Padding" Value="12,6"/>
                                    <Setter Property="MinHeight" Value="50"/>
                                    <Setter Property="Margin" Value="0,0,10,8"/>
                                </Style>
                                <Style x:Key="DashTileLabel" TargetType="{x:Type TextBlock}">
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Foreground" Value="{DynamicResource NavMutedBrush}"/>
                                </Style>
                                <Style x:Key="DashTileValue" TargetType="{x:Type TextBlock}">
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                </Style>
                                <Style x:Key="DashDot" TargetType="{x:Type Ellipse}">
                                    <Setter Property="Width" Value="12"/>
                                    <Setter Property="Height" Value="12"/>
                                    <Setter Property="Margin" Value="2,0,12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Fill" Value="{DynamicResource FaintTextBrush}"/>
                                </Style>
                                <!-- Section headings inside a card (Details, Placed in this job, Look and sound). -->
                                <Style x:Key="DashSub" TargetType="{x:Type TextBlock}">
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                    <Setter Property="Margin" Value="0,14,0,8"/>
                                </Style>
                                <Style x:Key="DashFieldLabel" TargetType="{x:Type TextBlock}">
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource NavMutedBrush}"/>
                                    <Setter Property="Margin" Value="0,0,0,3"/>
                                </Style>
                                <Style x:Key="DashTileButton" TargetType="{x:Type Button}">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border x:Name="b" Background="{DynamicResource SeactionHeaderBackgroundBrush}" CornerRadius="5" Padding="10,6,14,6" MinHeight="50">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <!-- "Opens outside Xenvious" arrow. -->
                                <Style x:Key="DashLinkIcon" TargetType="{x:Type Path}">
                                    <Setter Property="Data" Value="M9,1 L13,1 L13,5 M13,1 L7,7 M11,9 L11,13 L1,13 L1,3 L5,3"/>
                                    <Setter Property="Stroke" Value="{DynamicResource NavMutedBrush}"/>
                                    <Setter Property="StrokeThickness" Value="1.6"/>
                                    <Setter Property="Width" Value="14"/>
                                    <Setter Property="Height" Value="14"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                                <Style x:Key="DashChipButton" TargetType="{x:Type Button}">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource NavMutedBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border x:Name="b" Background="{DynamicResource SectionBackgroundBrush}" CornerRadius="11" Padding="10,3">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Cursor" Value="Arrow"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <!-- Team to test: a row of toggles instead of a small dropdown. -->
                                <Style x:Key="DashTeamButton" TargetType="{x:Type ToggleButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource NavMutedBrush}"/>
                                    <Setter Property="FontFamily" Value="{DynamicResource Volte}"/>
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Width" Value="28"/>
                                    <Setter Property="Height" Value="28"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Border x:Name="b" Background="Transparent" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource SeactionHeaderBackgroundBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <SolidColorBrush x:Key="DashPropBrush" Color="#FF6C5CE7"/>
                                <SolidColorBrush x:Key="DashDynamicBrush" Color="#FFC08BFF"/>
                                <!-- Same shapes as Advanced Prop Placement: light main action, grey secondary ones. -->
                                <Style x:Key="DashButton" TargetType="{x:Type Button}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                    <Setter Property="Background" Value="{DynamicResource SeactionHeaderBackgroundBrush}"/>
                                    <Setter Property="FontFamily" Value="{DynamicResource Volte}"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Height" Value="34"/>
                                    <Setter Property="Margin" Value="0,0,8,6"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border x:Name="b" CornerRadius="5" Background="{TemplateBinding Background}" Padding="10,0">
                                                    <ContentPresenter x:Name="c" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="c" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style x:Key="DashPrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource DashButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}"/>
                                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackground}"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border x:Name="b" CornerRadius="5" Background="{TemplateBinding Background}" Padding="10,0">
                                                    <ContentPresenter x:Name="c" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="c" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Grid.Resources>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Status bar: what Xenvious works with right now. Filled in MainWindow.Dashboard.cs. -->
                            <Border x:Name="DashboardStatusStrip" Grid.Row="0" Style="{StaticResource DashBar}" Margin="12,8,12,0">
                                <DockPanel LastChildFill="False">

                                    <!-- The whole tile opens the Social Club profile. -->
                                    <Button x:Name="BtnDashSC" DockPanel.Dock="Right" Style="{StaticResource DashTileButton}" Margin="0,0,0,8" Click="BtnDashSC_Click"
                                            ToolTip="{Binding Translation[dash_sc_open], FallbackValue='Open the Social Club profile'}">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="30" Height="30" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Ellipse Fill="{DynamicResource SelectedTileBrush}"/>
                                                <TextBlock x:Name="DashSCInitial" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}"/>
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                                <TextBlock Style="{StaticResource DashTileLabel}" Text="Social Club"/>
                                                <TextBlock x:Name="Lbl_SCName" Style="{StaticResource DashTileValue}" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                            </StackPanel>
                                            <Path Style="{StaticResource DashLinkIcon}"/>
                                        </StackPanel>
                                    </Button>

                                    <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                        <Border x:Name="DashTileGame" Style="{StaticResource DashTile}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="DashStatusGameDot" Style="{StaticResource DashDot}"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource DashTileLabel}" Text="{Binding Translation[dash_game], FallbackValue=Game}"/>
                                                    <TextBlock x:Name="DashStatusGame" Style="{StaticResource DashTileValue}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource DashTile}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="DashStatusCreatorDot" Style="{StaticResource DashDot}"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource DashTileLabel}" Text="{Binding Translation[dash_creator_label], FallbackValue=Creator}"/>
                                                    <TextBlock x:Name="DashStatusCreator" Style="{StaticResource DashTileValue}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <!-- Props and dynamic props in their in-game colours. -->
                                        <Border x:Name="DashTileProps" Style="{StaticResource DashTile}">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource DashTileLabel}" Text="{Binding Translation[dash_props_dynamic], FallbackValue='Props · Dynamic'}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,1,0,4">
                                                    <Ellipse Width="10" Height="10" Fill="{StaticResource DashPropBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="DashStatusProps" Style="{StaticResource DashTileValue}" Margin="0,0,14,0"/>
                                                    <Ellipse Width="10" Height="10" Fill="{StaticResource DashDynamicBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="DashStatusDynamic" Style="{StaticResource DashTileValue}"/>
                                                </StackPanel>
                                                <!-- Props against the prop limit; dynamic props are counted on their own. -->
                                                <Border Width="170" Height="6" CornerRadius="3" Background="{DynamicResource TextBoxBackground}" HorizontalAlignment="Left" ClipToBounds="True">
                                                    <Rectangle x:Name="DashPropsBar" Fill="{StaticResource DashPropBrush}" Width="0" HorizontalAlignment="Left"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <!-- The number that matters most in the open creator (checkpoints, actors, ...). -->
                                        <Border x:Name="DashTileMode" Style="{StaticResource DashTile}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="DashModeDot" Style="{StaticResource DashDot}" Fill="{DynamicResource OkBrush}"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="DashModeLabel" Style="{StaticResource DashTileLabel}"/>
                                                    <TextBlock x:Name="DashModeValue" Style="{StaticResource DashTileValue}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource DashTile}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="DashStatusScriptDot" Style="{StaticResource DashDot}"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource DashTileLabel}" Text="{Binding Translation[adv_features_label], FallbackValue='Script features'}"/>
                                                    <TextBlock x:Name="DashStatusScript" Style="{StaticResource DashTileValue}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </DockPanel>
                            </Border>

                            <!-- Layout: three columns; cards keep their own height instead of stretching with the window. -->
                            <ScrollViewer x:Name="DashScroll" Grid.Row="1" Margin="12,12,12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*" MinWidth="520"/>
                                        <ColumnDefinition Width="380"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ===== Left: creator actions ===== -->
                                    <Grid Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <Border Style="{StaticResource DashCard}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Style="{StaticResource DashCardHeader}">
                                                <TextBlock Style="{StaticResource DashCardTitle}" Text="{Binding Translation[dash_actions], FallbackValue='Creator Actions'}"/>
                                            </Border>
                                            <StackPanel Margin="14,12,6,12">
                                                <!-- Test: which team (race: primary or secondary slot) and the main action.
                                                     ddteamtest stays the source of the index; the toggles only set it. -->
                                                <ComboBox x:Name="ddteamtest" Visibility="Collapsed" SelectionChanged="ddmissionteamno_SelectionChanged">
                                                    <ComboBoxItem Content="1" Selector.IsSelected="True"/>
                                                    <ComboBoxItem Content="2"/>
                                                    <ComboBoxItem Content="3"/>
                                                    <ComboBoxItem Content="4"/>
                                                </ComboBox>
                                                <!-- One action per row; the team (race: route) toggles sit above Test. -->
                                                <Border x:Name="DashTeamPanel" HorizontalAlignment="Left" Background="{DynamicResource TextBoxBackground}" CornerRadius="5" Padding="3" Margin="0,0,8,6"
                                                        Visibility="{Binding ElementName=BtnTestMain, Path=Visibility}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Translation[dash_team], FallbackValue=Team}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource NavMutedBrush}" VerticalAlignment="Center" Margin="6,0,6,0"/>
                                                        <StackPanel x:Name="DashTeamButtons" Orientation="Horizontal"/>
                                                    </StackPanel>
                                                </Border>
                                                <Button x:Name="BtnTestMain" Height="36" Margin="0,0,8,8" Style="{StaticResource DashPrimaryButton}" Click="BtnTestMain_Click" Content="{Binding Translation[test], FallbackValue=Test}"/>
                                                <Rectangle Height="1" Fill="{DynamicResource LineBrush}" Margin="0,2,8,8"/>
                                                <Button x:Name="BtnSaveMain" Style="{StaticResource DashButton}" Click="BtnSaveMain_Click" Content="{Binding Translation[save], FallbackValue=Save}"/>
                                                <Button x:Name="BtnPublishMain" Style="{StaticResource DashButton}" Click="BtnPublishMain_Click" Content="{Binding Translation[publish], FallbackValue=Publish}"/>
                                                <Rectangle Height="1" Fill="{DynamicResource LineBrush}" Margin="0,2,8,8"/>
                                                <Button x:Name="BtnSkipTest" Style="{StaticResource DashButton}" Click="BtnSkipTest_Click" Content="{Binding Translation[skiptest], FallbackValue='Skip Testing'}"/>
                                                <Button x:Name="BtnTryFixBlackScreen" Style="{StaticResource DashButton}" Click="BtnTryFixBlackScreen_Click" Content="{Binding Translation[dash_fixblack], FallbackValue='Fix Black Screen'}"/>
                                                <Rectangle Height="1" Fill="{DynamicResource LineBrush}" Margin="0,2,8,8"/>
                                                <Button x:Name="BtnDashBackupMap" Style="{StaticResource DashButton}" Click="BtnDashBackupMap_Click" Content="{Binding Translation[dash_backupmap], FallbackValue='Backup Map'}"/>
                                                <Button x:Name="BtnDashReloadMap" Style="{StaticResource DashButton}" Click="BtnDashReloadMap_Click" Content="{Binding Translation[dash_reloadmap], FallbackValue='Reload Map'}"/>
                                                <Rectangle Height="1" Fill="{DynamicResource LineBrush}" Margin="0,2,8,8"/>

                                                <Grid Style="{StaticResource FormRow}" Margin="0,4,8,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource FormLabel}" Text="{Binding Translation[developermode], FallbackValue='Developer Mode'}"/>
                                                    <CheckBox x:Name="cb_dev" Grid.Column="1" Style="{StaticResource FormToggle}" Checked="cb_dev_Checked" Unchecked="cb_dev_Checked"/>
                                                </Grid>
                                                <Grid Style="{StaticResource FormRow}" Margin="0,0,8,0" ToolTip="{Binding Translation[np_camnocol_tip], FallbackValue='The creator camera passes through walls and the ground.'}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource FormLabel}" Text="{Binding Translation[np_camnocol], FallbackValue='Creator camera without collision'}"/>
                                                    <CheckBox x:Name="cbcamnocollision" Grid.Column="1" Style="{StaticResource FormToggle}" IsEnabled="False" Click="NativePatch_Click"/>
                                                </Grid>
                                                <Grid Style="{StaticResource FormRow}" Margin="0,0,8,0" ToolTip="{Binding Translation[np_nobudget_tip], FallbackValue='The budget bar stays empty. Too many entities can make the job fail to save or load.'}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource FormLabel}" Text="{Binding Translation[np_nobudget], FallbackValue='Ignore creator budget'}"/>
                                                    <CheckBox x:Name="cbnobudget" Grid.Column="1" Style="{StaticResource FormToggle}" IsEnabled="False" Click="NativePatch_Click"/>
                                                </Grid>
                                                <Grid Style="{StaticResource FormRow}" Margin="0,0,8,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource FormLabel}" Text="{Binding Translation[hidecreatormenu], FallbackValue='Hide Creator Menu'}"/>
                                                    <CheckBox x:Name="cbhidecreatormenu" Grid.Column="1" Style="{StaticResource FormToggle}" Checked="cbhidecreatormenu_Checked" Unchecked="cbhidecreatormenu_Checked"/>
                                                </Grid>

                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    </Grid>

                                    <!-- ===== Centre: the job ===== -->
                                    <Border Grid.Column="1" Style="{StaticResource DashCard}" VerticalAlignment="Top">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Style="{StaticResource DashCardHeader}">
                                                <DockPanel>
                                                    <!-- Job id; a link to the job page once the job is published. -->
                                                    <Button x:Name="BtnDashJobId" DockPanel.Dock="Right" Style="{StaticResource DashChipButton}" Click="BtnDashJobId_Click" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="tbjobid" FontSize="12" FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            <Path x:Name="DashJobIdIcon" Style="{StaticResource DashLinkIcon}" Width="11" Height="11" Stretch="Uniform" Margin="7,0,0,0"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBlock Style="{StaticResource DashCardTitle}" Text="{Binding Translation[infoheader], FallbackValue='Job Information'}"/>
                                                </DockPanel>
                                            </Border>

                                            <!-- Details and counts at the bottom; image, title and description on top at a fixed height. -->
                                            <DockPanel Margin="14,12,14,6">
                                                <!-- Count tiles for the open creator, built in MainWindow.DashboardCreator.cs; a click opens the page. -->
                                                <UniformGrid x:Name="DashCounts" DockPanel.Dock="Bottom" Rows="1" Margin="0,0,-8,0"/>
                                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource DashSub}" Text="{Binding Translation[dash_placed], FallbackValue='Placed in this job'}"
                                                           ToolTip="{Binding Translation[dash_counts_hint], FallbackValue='Click opens the page in Edit'}"/>
                                                <Rectangle DockPanel.Dock="Bottom" Height="1" Fill="{DynamicResource LineBrush}" Margin="0,14,0,0"/>
                                                <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,0,-10,0">
                                                    <StackPanel Margin="0,0,10,10">
                                                        <TextBlock Style="{StaticResource DashFieldLabel}" Text="{Binding Translation[jobtype], FallbackValue='Job Type'}"/>
                                                        <Grid Height="32">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="30"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ComboBox x:Name="ddjobtype" FontFamily="{DynamicResource Volte}" SelectionChanged="ddjobtype_SelectionChanged">
                                                                <ComboBoxItem Content="{Binding Translation[mission], FallbackValue=Mission}"/>
                                                                <ComboBoxItem Content="{Binding Translation[deathmatch], FallbackValue=Deathmatch}"/>
                                                                <ComboBoxItem Content="{Binding Translation[race], FallbackValue=Race}"/>
                                                                <ComboBoxItem Content="{Binding Translation[survival], FallbackValue=Survival}"/>
                                                            </ComboBox>
                                                            <TextBox x:Name="tbjobtype" Style="{StaticResource Watermark}" FontSize="14" TextChanged="tbjobtype_TextChanged" KeyDown="FormatTextForInteger" Visibility="Hidden"/>
                                                            <!-- Switches between the dropdowns and raw numbers for type and subtype. -->
                                                            <Button x:Name="Btnjobtypeswitch" Grid.Column="1" Width="24" Height="24" HorizontalAlignment="Right" Style="{DynamicResource TitleBarButton}" Click="Btnjobtypeswitch_Click" ToolTip="Dropdown / number">
                                                                <Image x:Name="jobtypeswitchimage" Source="{StaticResource switch}" Width="18" Height="18"/>
                                                            </Button>
                                                        </Grid>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,10,10">
                                                        <Label x:Name="Lbljobsubtype" Content="Type" Padding="0" Margin="0,0,0,3" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource NavMutedBrush}"/>
                                                        <Grid Height="32">
                                                            <ComboBox x:Name="ddjobsubtype" FontFamily="{DynamicResource Volte}" SelectionChanged="ddjobsubtype_SelectionChanged"/>
                                                            <TextBox x:Name="tbjobsubtype" Style="{StaticResource Watermark}" FontSize="14" TextChanged="tbjobsubtype_TextChanged" KeyDown="FormatTextForInteger" Visibility="Hidden"/>
                                                        </Grid>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,10,10" Visibility="{Binding ElementName=tbjobracetype, Path=Visibility}">
                                                        <TextBlock Style="{StaticResource DashFieldLabel}" Text="{Binding Translation[subtyperace], FallbackValue='Race subtype'}"/>
                                                        <TextBox x:Name="tbjobracetype" Style="{StaticResource Watermark}" Height="32" FontSize="14" TextChanged="tbjobracetype_TextChanged" KeyDown="FormatTextForInteger" Visibility="Collapsed"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,10,10">
                                                        <TextBlock Style="{StaticResource DashFieldLabel}" Text="{Binding Translation[rounds], FallbackValue=Rounds}"/>
                                                        <TextBox x:Name="tb_Rounds" Style="{StaticResource Watermark}" Height="32" FontSize="14" ToolTip="{Binding Translation[rounds_info], FallbackValue=Define how many Rounds one has to play to finish the Job.}" TextChanged="tb_Rounds_TextChanged" KeyDown="FormatTextForInteger"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,10,10">
                                                        <TextBlock Style="{StaticResource DashFieldLabel}" Text="{Binding Translation[teams], FallbackValue=Teams}"/>
                                                        <TextBox x:Name="tb_Teams" Style="{StaticResource Watermark}" Height="32" FontSize="14" ToolTip="{Binding Translation[teams_info], FallbackValue=Define how many Teams your Job has.}" TextChanged="tb_Teams_TextChanged" KeyDown="FormatTextForInteger"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,10,10">
                                                        <TextBlock Style="{StaticResource DashFieldLabel}" Text="{Binding Translation[minp], FallbackValue='Minimum Players'}"/>
                                                        <TextBox x:Name="tb_minp" Style="{StaticResource Watermark}" Height="32" FontSize="14" ToolTip="{Binding Translation[minp_info], FallbackValue=Define the minimum Player count.}" TextChanged="tb_minp_TextChanged" KeyDown="FormatTextForInteger"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,10,10">
                                                        <TextBlock Style="{StaticResource DashFieldLabel}" Text="{Binding Translation[maxp], FallbackValue='Maximum Players'}"/>
                                                        <TextBox x:Name="tb_maxp" Style="{StaticResource Watermark}" Height="32" FontSize="14" ToolTip="{Binding Translation[maxp_info], FallbackValue=Define the maximum Player count. (If you make solo Missions make sure to add 1)}" TextChanged="tb_maxp_TextChanged" KeyDown="FormatTextForInteger"/>
                                                    </StackPanel>
                                                </UniformGrid>
                                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource DashSub}" Text="{Binding Translation[detailsheader], FallbackValue=Details}"/>
                                                <Rectangle DockPanel.Dock="Bottom" Height="1" Fill="{DynamicResource LineBrush}" Margin="0,14,0,0"/>
                                                <Grid Height="200">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="356"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Job image; hovering shows view / save / change. -->
                                                    <Grid Grid.Column="0" Margin="0,0,14,0">
                                                        <Border CornerRadius="4" Background="{DynamicResource TextBoxBackground}"/>
                                                        <Viewbox MaxWidth="200" MaxHeight="120" Visibility="{Binding ElementName=ImagePremiumNeeded, Path=Visibility}">
                                                            <TextBlock x:Name="ImagePremiumNeeded" Visibility="Collapsed" Text="Not available.&#xA;Premium Version needed!" Foreground="{DynamicResource TextColor}" FontSize="26" TextAlignment="Center" FontWeight="Bold"/>
                                                        </Viewbox>
                                                        <Button x:Name="MainImageContainer" Visibility="Visible" FocusVisualStyle="{x:Null}" Focusable="False">
                                                            <Button.Template>
                                                                <ControlTemplate>
                                                                    <Grid Background="Transparent">
                                                                        <Image x:Name="JobImage" Source="{DynamicResource emptyblank}"/>
                                                                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" x:Name="BtnJobContainer" Visibility="Collapsed">
                                                                            <Border CornerRadius="5" Background="{DynamicResource SectionBackgroundBrush}" Margin="10 3" Height="28" Width="170">
                                                                                <Border.Resources>
                                                                                    <Style TargetType="Border">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding ElementName=JobImage, Path=Source}" Value="{StaticResource emptyblank}">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Resources>
                                                                                <Button x:Name="BtnJobView" Focusable="False" FontSize="14" Style="{DynamicResource CustomButton}" local:CornerRadiusSetter.CornerRadius="5" Click="JobImage_MouseLeftButtonDown" Content="{Binding Translation[view], FallbackValue=display}"/>
                                                                            </Border>
                                                                            <Border CornerRadius="5" Background="{DynamicResource SectionBackgroundBrush}" Margin="10 3" Height="28" Width="170">
                                                                                <Button x:Name="BtnJobImageSave" Focusable="False" FontSize="14" Style="{DynamicResource CustomButton}" local:CornerRadiusSetter.CornerRadius="5" Click="BtnJobImageSave_Click" Content="{Binding Translation[saveimage], FallbackValue=Save Image}"/>
                                                                            </Border>
                                                                            <Border CornerRadius="5" Background="{DynamicResource SectionBackgroundBrush}" Margin="10 3" Height="28" Width="170">
                                                                                <Button x:Name="BtnJobImage" Focusable="False" FontSize="14" Style="{DynamicResource CustomButton}" local:CornerRadiusSetter.CornerRadius="5" Click="BtnJobImage_Click" Content="{Binding Translation[changeimage], FallbackValue=Change Image}"/>
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="true">
                                                                            <Setter TargetName="BtnJobContainer" Property="Visibility" Value="Visible"/>
                                                                            <Setter TargetName="BtnJobView" Property="Focusable" Value="True"/>
                                                                            <Setter TargetName="BtnJobImage" Property="Focusable" Value="True"/>
                                                                            <Setter TargetName="JobImage" Property="Opacity" Value="0.1"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </Grid>

                                                    <DockPanel Grid.Column="1">
                                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource DashFieldLabel}" Text="{Binding Translation[title], FallbackValue=Title}"/>
                                                        <TextBox x:Name="tb_JobTitle" DockPanel.Dock="Top" Style="{StaticResource Watermark}" Height="32" MaxLength="50" FontSize="14" TextChanged="tb_JobTitle_TextChanged" Margin="0,0,0,8"/>
                                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource DashFieldLabel}" Text="{Binding Translation[desc], FallbackValue=Describtion}"/>
                                                        <TextBlock x:Name="DashDescBytes" DockPanel.Dock="Bottom" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Margin="0,3,0,0" Foreground="{DynamicResource NavMutedBrush}" ToolTip="{Binding Translation[dash_desc_bytes], FallbackValue='The creator stores up to 504 bytes; umlauts and emoji take 2-4 bytes each.'}"/>
                                                        <TextBox x:Name="tb_JobDec" Style="{StaticResource WatermarkOld}" MinHeight="80" MaxLength="500" FontSize="14" TextWrapping="Wrap" AcceptsReturn="False" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="tb_JobDec_TextChanged"/>
                                                    </DockPanel>
                                                </Grid>

                                            </DockPanel>
                                        </DockPanel>
                                    </Border>


                                    <!-- ===== Right: ambient ===== -->
                                    <Border Grid.Column="2" Style="{StaticResource DashCard}" Margin="12,0,0,12" VerticalAlignment="Top">
                                        <StackPanel>
                                            <Border Style="{StaticResource DashCardHeader}">
