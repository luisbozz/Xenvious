                    <TabItem x:Name="PageEdit" Header="Edit" Height="27" VerticalAlignment="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="EditNavColumn" Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Side list of the Edit pages, built in MainWindow.EditNav.cs: pages of the open
                                 creator in groups, their sub-pages, a search and the script patch status. -->
                            <Border Grid.Column="0" Background="{DynamicResource SectionBackgroundBrush}" CornerRadius="5" Margin="10,10,0,10">
                                <DockPanel Margin="8">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <Button x:Name="BtnEditNavCollapse" DockPanel.Dock="Left" Style="{StaticResource NavButton}" Padding="7" Margin="0,0,6,0" Click="BtnEditNavCollapse_Click"
                                                ToolTip="{Binding Translation[editnav_collapse], FallbackValue='Collapse or expand the list'}">
                                            <Viewbox Style="{StaticResource NavIconBox}" Margin="0">
                                                <Canvas Width="24" Height="24"><Path x:Name="EditNavCollapseIcon" Style="{StaticResource NavIcon}" Data="{StaticResource EditIconBack}"/></Canvas>
                                            </Viewbox>
                                        </Button>
                                        <!-- A bare text line like the search in the drop-downs: grey hint until something is typed, a line under it. -->
                                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBox x:Name="tbEditNavSearch" Background="Transparent" BorderThickness="0" Padding="4,6,4,6" FontSize="14" Foreground="{DynamicResource TextColor}" CaretBrush="{DynamicResource TextColor}" TextChanged="tbEditNavSearch_TextChanged"/>
                                                <TextBlock IsHitTestVisible="False" Margin="7,6,4,6" FontSize="14" Foreground="{DynamicResource FaintTextBrush}" Text="{Binding Translation[editnav_search], FallbackValue='Search pages'}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=tbEditNavSearch}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DockPanel>

                                    <!-- Script patches of the open creator: status only; switching stays in Misc. -->
                                    <Button x:Name="BtnEditScriptStatus" DockPanel.Dock="Bottom" Style="{StaticResource SideNavButton}" Margin="0,6,0,0" Click="BtnEditScriptStatus_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="EditScriptDot" Width="9" Height="9" Margin="2,0,10,0" VerticalAlignment="Center" Fill="{DynamicResource FaintTextBrush}"/>
                                            <TextBlock x:Name="EditScriptLabel" Style="{StaticResource NavLabel}" Text="{Binding Translation[adv_features_label], FallbackValue='Script features'}"/>
                                            <TextBlock x:Name="EditScriptSummary" Style="{StaticResource NavLabel}" Margin="10,0,0,0" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Popup x:Name="EditScriptPopup" DockPanel.Dock="Bottom" PlacementTarget="{Binding ElementName=BtnEditScriptStatus}" Placement="Top"
                                           StaysOpen="False" AllowsTransparency="True">
                                        <Border Background="{DynamicResource SeactionHeaderBackgroundBrush}" CornerRadius="6" Padding="12,10" Width="330" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock x:Name="EditScriptPopupTitle" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource FaintTextBrush}" Margin="0,0,0,6"/>
                                                <StackPanel x:Name="EditScriptList"/>
                                                <DockPanel Margin="0,8,0,0">
                                                    <Button x:Name="BtnEditScriptRefresh" DockPanel.Dock="Left" Style="{StaticResource NavButton}" Click="BtnEditScriptRefresh_Click">
                                                        <TextBlock Style="{StaticResource NavLabel}" Text="{Binding Translation[editnav_refresh], FallbackValue='Check again'}"/>
                                                    </Button>
                                                    <Button x:Name="BtnEditScriptMisc" HorizontalAlignment="Right" Style="{StaticResource NavButton}" Click="BtnEditScriptMisc_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource NavLabel}" Text="{Binding Translation[editnav_toscrpatches], FallbackValue='Misc › Script Patches'}"/>
                                                            <Path Style="{StaticResource GoToPageIcon}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </Popup>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <StackPanel x:Name="EditNavResults"/>
                                            <StackPanel x:Name="EditNavList"/>
                                        </StackPanel>
                                    </ScrollViewer>
