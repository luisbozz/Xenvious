                                                <CheckBox x:Name="cbsettingscheckupdates" Grid.Column="1" Style="{StaticResource FormToggle}" Checked="cbsettingscheckupdates_Checked" Unchecked="cbsettingscheckupdates_Checked"/>
                                            </Grid>
