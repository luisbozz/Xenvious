<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Xenvious.Logging.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:logging="clr-namespace:Xenvious.Logging"
             xmlns:xenvious="clr-namespace:Xenvious"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Level brushes only (simpler, broad-compat) -->
        <SolidColorBrush x:Key="Brush.Trace" Color="#8898A6"/>
        <SolidColorBrush x:Key="Brush.Debug" Color="#2D7DD2"/>
        <SolidColorBrush x:Key="Brush.Info"  Color="#2FBF71"/>
        <SolidColorBrush x:Key="Brush.Warn"  Color="#D98E2B"/>
        <SolidColorBrush x:Key="Brush.Error" Color="#D64545"/>
        <SolidColorBrush x:Key="Brush.Fatal" Color="#A61C1C"/>
    </UserControl.Resources>

    <Border CornerRadius="14" Padding="12" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <DockPanel Margin="0,0,0,10">
                <TextBlock Text="Debug Log" FontSize="16" FontWeight="SemiBold" Foreground="#E6EAF2" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Fill="#6C7378" Width="1" Margin="15,8,15,8" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Label Content="{Binding Translation[logger_autoscroll], FallbackValue=Auto-Scroll}" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                    <CheckBox x:Name="AutoScrollCheck" IsChecked="True" Content="Auto-Scroll" Foreground="#E6EAF2"/>
                    <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Fill="#6C7378" Width="1" Margin="15,8,15,8" />
                    <Border CornerRadius="5" Background="{DynamicResource SectionBackgroundBrush}" Margin="4" VerticalAlignment="Bottom" MaxHeight="30">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="{DynamicResource ShadowColor}"/>
                        </Border.Effect>
                        <Button x:Name="CopyBtn" FontSize="16" Style="{DynamicResource CustomButton}" xenvious:CornerRadiusSetter.CornerRadius="5" Content="{Binding Translation[logger_copy], FallbackValue=Copy}" Foreground="{DynamicResource TextColor}" Click="CopyBtn_Click"/>
                    </Border>
                    <Border CornerRadius="5" Background="{DynamicResource SectionBackgroundBrush}" Margin="4" VerticalAlignment="Bottom" MaxHeight="30">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="{DynamicResource ShadowColor}"/>
                        </Border.Effect>
                        <Button x:Name="CopyAllBtn" FontSize="16" Style="{DynamicResource CustomButton}" xenvious:CornerRadiusSetter.CornerRadius="5" Content="{Binding Translation[logger_copyall], FallbackValue=Copy All}" Foreground="{DynamicResource TextColor}" Click="CopyAllBtn_Click"/>
                    </Border>
                    <Border CornerRadius="5" Background="{DynamicResource SectionBackgroundBrush}" Margin="4" VerticalAlignment="Bottom" MaxHeight="30">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="{DynamicResource ShadowColor}"/>
                        </Border.Effect>
                        <Button x:Name="ClearBtn" FontSize="16" Style="{DynamicResource CustomButton}" xenvious:CornerRadiusSetter.CornerRadius="5" Content="{Binding Translation[logger_clear], FallbackValue=Clear}" Foreground="{DynamicResource TextColor}" Click="ClearBtn_Click"/>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- Search -->
            <TextBox x:Name="SearchBox" Grid.Row="1" Padding="8" TextChanged="SearchBox_TextChanged" Style="{StaticResource Watermark}" Tag="{Binding Translation[logger_search], FallbackValue=Search}"/>

            <!-- Log list -->
            <ListBox x:Name="List" Grid.Row="2" Margin="0,10,0,0" FontFamily="Cascadia Code, Consolas, 'Segoe UI Mono'"
                     Background="{DynamicResource SeactionHeaderBackgroundBrush}" Foreground="#E6EAF2" BorderBrush="#232637" BorderThickness="1"
                     SelectionMode="Extended" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type logging:LogEntry}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Opacity="0.8"/>
                            <Border Grid.Column="1" Padding="4,1" CornerRadius="6" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Level}" FontWeight="Bold"/>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#212435"/>
                                        <Setter Property="BorderBrush" Value="#2C3147"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Trace">
                                                <Setter Property="Background" Value="#1B1F2B"/>
                                                <Setter Property="BorderBrush" Value="#2C3147"/>
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Trace}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Debug">
                                                <Setter Property="Background" Value="#10223A"/>
                                                <Setter Property="BorderBrush" Value="#2D3E59"/>
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Debug}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Info">
                                                <Setter Property="Background" Value="#0E2317"/>
                                                <Setter Property="BorderBrush" Value="#254735"/>
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Info}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                <Setter Property="Background" Value="#2E2110"/>
                                                <Setter Property="BorderBrush" Value="#5A4524"/>
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Warn}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                <Setter Property="Background" Value="#2E1414"/>
                                                <Setter Property="BorderBrush" Value="#5A2A2A"/>
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Error}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Fatal">
                                                <Setter Property="Background" Value="#3A1111"/>
                                                <Setter Property="BorderBrush" Value="#6B2323"/>
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Fatal}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Grid.Column="2" TextWrapping="Wrap">
                                <Run Text="{Binding Source, Mode=OneWay, StringFormat=[{0}], TargetNullValue=''}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Message, Mode=OneWay}"/>
                                <Run Text="{Binding ExceptionMessage, Mode=OneWay, TargetNullValue='', StringFormat=  (EX: {0})}"/>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Name="_Border" Padding="2" SnapsToDevicePixels="true">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="true">
                                            <Setter TargetName="_Border" Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="false">
                                            <Setter Property="Foreground" Value="#888"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="true"/>
                                                <Condition Property="IsSelected" Value="false"/>
                                            </MultiTrigger.Conditions>
                                            <MultiTrigger.Setters>
                                                <Setter TargetName="_Border" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                            </MultiTrigger.Setters>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Border>
</UserControl>